---
import AppLayout from '../layouts/AppLayout.astro';
import PromptDetailContent from '../components/PromptDetailContent.astro';
import { prompts, categories, thumbUrl, isVideoThumb } from '../data/prompts';

// Masonry rhythm: cycle each card through short/medium/tall so the grid reads
// like motionsites.ai instead of a flat row of equal-height cards. Plain
// modulo (no per-slug hash) — good enough variety, zero extra bookkeeping.
const SIZE_CLASSES = ['pv-m', 'pv-l', 'pv-s', 'pv-m', 'pv-s', 'pv-l'];
// Animated-GIF covers are recordings of the real landing page and only read
// correctly at 16:9 — cropping one into a square or portrait slot would cut
// the video off. They opt out of the s/m/l cycle instead of consuming a slot
// in it, so every other card keeps the exact size it already had.
const isGifCover = (p) => thumbUrl(p.thumbnail).toLowerCase().endsWith('.gif') || isVideoThumb(p.thumbnail);
// These screenshots are full-width hero shots — forcing them into a square
// or 3:4 slot meant either cropping the nav/headline off the sides or, on
// pages with a lot of scroll, stretching the crop tall enough to swallow
// the section *after* the hero too. Both looked broken, so they get the
// same 16:9 opt-out as the GIF covers instead of fighting the s/m/l cycle.
const FORCE_16_9 = new Set([
  'velo-moto', 'storefront-v1-skincare', 'storefront-v2-wellness', 'warebotics-robotics', 'lunea-skincare',
]);
const sizeClass = (p, i) => {
  if (isGifCover(p) || FORCE_16_9.has(p.slug)) return 'pv-16-9';
  if (p.tier === 'Full LP') return 'pv-auto';
  return SIZE_CLASSES[i % SIZE_CLASSES.length];
};
---
<AppLayout title="Library">
  <div class="shead reveal">
    <span class="eyebrow" id="catBadge">{prompts.length} Prompts →</span>
    <h1 class="cat-heading">
      <span id="catHeadLine1">{prompts.length} prompts,</span>
      <span id="catHeadLine2">built at the speed of thought.</span>
    </h1>
    <p id="catSubhead">{prompts.length} hero, section, and full landing page prompts, shipped from prompt to pixel with Cursor, v0, or Lovable.</p>
  </div>

  <!-- Tier switching lives in the nav (Hero/Landing/Section) — no need to
       duplicate it as an on-page control. This row is category only. -->
  <div class="catalog-controls reveal" id="catalogControls">
    <div class="pill-scroll" id="categoryScroll">
      <button class="pill active" data-filter="category" data-value="all">All</button>
      {categories.map(c => <button class="pill" data-filter="category" data-value={c}>{c}</button>)}
    </div>
    <div class="sort-dropdown" id="sortDropdown">
      <button class="sort-btn" id="sortBtn" type="button" aria-haspopup="true" aria-expanded="false">
        <span id="sortLabel">Most Recent</span>
        <svg class="lucide" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></svg>
      </button>
      <div class="sort-menu" id="sortMenu" hidden>
        <button type="button" class="active" data-sort="recent">Most Recent</button>
        <button type="button" data-sort="recommended">Recommended</button>
        <button type="button" data-sort="viewed">Most Viewed</button>
      </div>
    </div>
  </div>

  <div class="showcase-grid" id="catalogGrid">
    {prompts.map((p, i) => (
      <div class="citem scard" data-slug={p.slug} data-tier={p.tier} data-category={p.category} data-title={p.title.toLowerCase()} data-free={p.free ? 'true' : 'false'}>
        <div class="cc">
          {isVideoThumb(p.thumbnail) ? (
            <div class={`pv ${sizeClass(p, i)}`}>
              <video class="pv-video" data-src={thumbUrl(p.thumbnail)} muted loop playsinline preload="none"></video>
              <div class="pv-overlay">
                <button class="pv-btn copy" data-slug={p.slug}>
                  <svg class="lucide pv-copy-icon" viewBox="0 0 24 24"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                  <span>Copy Prompt</span>
                </button>
                <button class="pv-btn ghost view" data-slug={p.slug}>
                  <svg class="lucide" viewBox="0 0 24 24"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                  <span>View Detail</span>
                </button>
              </div>
            </div>
          ) : (
            <div class={`pv ${sizeClass(p, i)}`} data-bg={thumbUrl(p.thumbnail)}>
              <div class="pv-overlay">
                <button class="pv-btn copy" data-slug={p.slug}>
                  <svg class="lucide pv-copy-icon" viewBox="0 0 24 24"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                  <span>Copy Prompt</span>
                </button>
                <button class="pv-btn ghost view" data-slug={p.slug}>
                  <svg class="lucide" viewBox="0 0 24 24"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                  <span>View Detail</span>
                </button>
              </div>
            </div>
          )}
        </div>
        <div class="ccap">
          <span class="name">{p.title}</span>
          <span class="ccap-meta">
            <span class={`plan-badge ${p.free ? 'free' : 'premium'}`}>{p.free ? 'Free' : 'Premium'}</span>
            <span class="count">{p.tier === p.category ? p.tier : `${p.tier} - ${p.category}`}</span>
            <span class="view-count" data-slug={p.slug}>
              <svg class="lucide" viewBox="0 0 24 24"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
              <span class="vc-num">0</span>
            </span>
          </span>
        </div>
      </div>
    ))}
  </div>

  <p class="empty-state" id="catalogEmpty" hidden>No prompts match your search or filters.</p>

  <!-- Pre-rendered detail content per item, kept inert inside <template> until
       cloned into the modal below. Avoids a client-side data fetch/JSON dupe. -->
  {prompts.map((p) => (
    <template id={`tpl-${p.slug}`}>
      <PromptDetailContent item={p} />
    </template>
  ))}

  <div class="detail-overlay" id="detailOverlay">
    <div class="detail-modal">
      <!-- Positioned relative to the modal card itself (not the viewport)
           so they sit a fixed 24px off its edges regardless of screen width. -->
      <button class="pd-arrow pd-arrow-prev" id="detailPrev" aria-label="Previous prompt">
        <svg class="lucide" viewBox="0 0 24 24"><path d="m15 18-6-6 6-6"/></svg>
      </button>
      <button class="pd-arrow pd-arrow-next" id="detailNext" aria-label="Next prompt">
        <svg class="lucide" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></svg>
      </button>
      <div id="detailModalBody"></div>
    </div>
  </div>
</AppLayout>

<style>
  /* hero-style page header — same eyebrow+headline language as the
     homepage hero, scaled down for a section (not full viewport) */
  .shead{text-align:center;max-width:800px;margin:0 auto 40px}
  .shead .eyebrow::before{background:#fff;box-shadow:0 0 6px rgba(255,255,255,.5)}
  .cat-heading{font-size:46px;font-weight:600;letter-spacing:-.03em;line-height:1.1;margin:14px 0 14px;color:#fff}
  .cat-heading span{display:block;white-space:nowrap}
  .shead p{font-size:17px;max-width:480px;margin:0 auto}
  @media(max-width:900px){ .cat-heading{font-size:30px} .cat-heading span{white-space:normal} }

  .catalog-controls{display:flex;align-items:center;gap:12px;margin-bottom:36px;position:relative;z-index:5}
  .pill-scroll{display:flex;gap:8px;overflow-x:auto;flex:1;scrollbar-width:none;padding-bottom:2px}
  .pill-scroll::-webkit-scrollbar{display:none}
  .pill-scroll .pill{flex:0 0 auto}

  .sort-dropdown{position:relative;flex:0 0 auto}
  .sort-btn{display:inline-flex;align-items:center;gap:6px;background:#fff;color:#0d0c14;border:none;
    border-radius:999px;padding:8px 14px;font-family:var(--sans);font-size:12.5px;font-weight:600;cursor:pointer;white-space:nowrap}
  .sort-btn .lucide{width:14px;height:14px;transition:transform .15s}
  .sort-btn[aria-expanded="true"] .lucide{transform:rotate(180deg)}
  .sort-menu{position:absolute;top:calc(100% + 8px);right:0;min-width:170px;background:var(--panel);
    border:1px solid var(--line2);border-radius:12px;padding:6px;display:flex;flex-direction:column;gap:2px;
    z-index:20;box-shadow:0 24px 60px -20px rgba(0,0,0,.6)}
  .sort-menu button{display:block;width:100%;text-align:left;padding:9px 11px;border-radius:8px;
    font-size:13.5px;color:var(--mut);background:none;border:none;cursor:pointer;font-family:var(--sans)}
  .sort-menu button:hover{background:rgba(255,255,255,.06);color:#fff}
  .sort-menu button.active{color:#fff}

  .empty-state{text-align:center;color:var(--mut);padding:60px 0;font-size:15px}
  .empty-state-progress{text-align:center;color:var(--mut);padding:90px 20px;font-size:15.5px;
    display:flex;flex-direction:column;gap:10px}
  .empty-state-progress a{color:var(--ink);text-decoration:underline;text-underline-offset:3px}
  .empty-state-progress a:hover{color:var(--accent,#7c5cff)}
  .citem[hidden]{display:none}

  .view-count{display:inline-flex;align-items:center;gap:4px;font-family:var(--mono);font-size:10.5px;color:var(--dim);white-space:nowrap}
  .view-count .lucide{width:12px;height:12px}

  /* Masonry: CSS Grid with a 1px row unit + JS-computed `grid-row-end: span`
     per card (the standard no-library masonry technique), not CSS
     multi-column. Multi-column balances by *estimated total height / column
     count*, which routinely leaves the last column short — a visible dead
     gap on the right, exactly what this replaces. Grid dense-packs each
     item into its row span instead, so every column runs flush to the
     bottom. */
  .showcase-grid.masonry{display:grid;grid-template-columns:repeat(3,1fr);grid-auto-rows:1px;grid-auto-flow:dense;gap:20px;align-items:start}
  @media(max-width:900px){ .showcase-grid.masonry{grid-template-columns:repeat(2,1fr)} }
  @media(max-width:560px){ .showcase-grid.masonry{grid-template-columns:1fr} }
  /* .cc .pv.pv-x (not just .pv-x) so this outweighs tokens.css's
     `.showcase-grid .cc .pv{aspect-ratio:16/9}` — a same-specificity tier
     collided with that rule here before and silently lost, collapsing
     every card to ~0 height. */
  .showcase-grid.masonry .cc .pv.pv-s{aspect-ratio:1/1}
  .showcase-grid.masonry .cc .pv.pv-m{aspect-ratio:4/3}
  .showcase-grid.masonry .cc .pv.pv-l{aspect-ratio:3/4}
  /* Animated-GIF/video covers stay 16:9 — they're recordings, not crops. */
   .showcase-grid.masonry .cc .pv.pv-16-9{aspect-ratio:16/9}
   .showcase-grid.masonry .cc .pv.pv-auto{aspect-ratio:4/3}
   .showcase-grid .cc .pv.pv-portrait{background-size:auto 100%;background-position:top center}
</style>

<script is:inline>
  /* The prompt text is stored once, in the .pd-code block of each item's detail
     markup. Reading it back from there keeps a 1,700-word prompt out of a
     duplicate data-prompt attribute — that duplication was most of the page weight. */
  function espPromptText(btn){
    const open=btn.closest('.prompt-detail')?.querySelector('.pd-code');
    if(open) return open.textContent||'';
    const tpl=document.getElementById('tpl-'+(btn.dataset.slug||''));
    return tpl?.content.querySelector('.pd-code')?.textContent||'';
  }
  const grid = document.getElementById('catalogGrid');
  const items = [...grid.querySelectorAll('.citem')];

  // Thumbnails only start loading (and, for the animated GIF covers, only
  // start decoding/playing) once a card scrolls near the viewport. Filtering
  // to a tier still shows a dozen+ cards, and setting every GIF's
  // background-image up front on page load makes them all decode at once —
  // that simultaneous-decode contention is what reads as "patah-patah"
  // (stuttery) playback, especially since they're hotlinked from a single
  // non-CDN host. Static images benefit too (fewer requests up front).
  const bgIO = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (!entry.isIntersecting) return;
      const el = entry.target;
      el.style.backgroundImage = `url('${el.dataset.bg}')`;
      const image = new Image();
      image.onload = () => {
        const sourceRatio = image.naturalWidth / image.naturalHeight;
        if (el.classList.contains('pv-auto')) el.style.aspectRatio = `${image.naturalWidth} / ${image.naturalHeight}`;
        const slotRatio = el.clientWidth / el.clientHeight;
        el.classList.toggle('pv-portrait', sourceRatio < slotRatio);
        scheduleMasonryLayout();
      };
      image.src = el.dataset.bg;
      bgIO.unobserve(el);
    });
  }, { rootMargin: '200px 0px' });
  grid.querySelectorAll('.pv[data-bg]').forEach(el => bgIO.observe(el));

  // .webm covers (real <video> elements, can't use background-image) get the
  // same lazy-start treatment: src stays unset until the card nears the
  // viewport, then it loads and plays. Paused (not removed) once it scrolls
  // back out, so re-entering the viewport resumes instantly without a re-fetch.
  const videoIO = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      const el = entry.target;
      if (entry.isIntersecting) {
        if (!el.src && el.dataset.src) el.src = el.dataset.src;
        el.play?.().catch(() => {});
      } else {
        el.pause?.();
      }
    });
  }, { rootMargin: '200px 0px' });
  grid.querySelectorAll('.pv-video[data-src]').forEach(el => videoIO.observe(el));
  const empty = document.getElementById('catalogEmpty');
  const state = { tier: 'all', category: 'all', q: '', sort: 'recent' };

  // View counts are stored per-browser in localStorage and updated every time
  // a user opens a prompt detail modal. This is real-time for the current user,
  // but not a global backend counter.
  const VIEWS_KEY = 'esprompt:views';
  function getViewsMap(){
    try { return JSON.parse(localStorage.getItem(VIEWS_KEY) || '{}'); }
    catch(e) { return {}; }
  }
  function saveViewsMap(map){ localStorage.setItem(VIEWS_KEY, JSON.stringify(map)); }
  function getViews(slug){ return getViewsMap()[slug] || 0; }
  function incrementViews(slug){
    const map = getViewsMap();
    map[slug] = (map[slug] || 0) + 1;
    saveViewsMap(map);
    renderViewCount(slug);
  }
  function renderViewCount(slug){
    const n = getViews(slug);
    document.querySelectorAll(`.view-count[data-slug="${slug}"] .vc-num`).forEach(el => el.textContent = String(n));
  }
  function renderAllViewCounts(){
    items.forEach(item => renderViewCount(item.dataset.slug));
  }
  renderAllViewCounts();

  // Copy button shows a lock while signed out (gated action) and a plain
  // clipboard once signed in, or for free items regardless of session
  // (nothing to gate there — copy just works).
  const ICON_LOCKED = '<rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>';
  const ICON_UNLOCKED = '<rect width="8" height="4" x="8" y="2" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/>';
  function updateCopyIcons(){
    const signedIn = window.espHasSession && window.espHasSession();
    document.querySelectorAll('.pv-copy-icon').forEach(svg => {
      const isFree = svg.closest('.citem')?.dataset.free === 'true';
      svg.innerHTML = (signedIn || isFree) ? ICON_UNLOCKED : ICON_LOCKED;
    });
  }
  updateCopyIcons();
  window.addEventListener('esprompt:session-change', updateCopyIcons);

  // Grid-based masonry (see the .masonry CSS above): each card gets a
  // `grid-row-end: span N` sized to its own rendered height, in 1px row
  // units, so `grid-auto-flow: dense` can pack shorter neighbors into the
  // gap a taller card leaves — that's what keeps every column running flush
  // to the bottom instead of one trailing off early.
  function layoutMasonry(){
    if (!grid.classList.contains('masonry')) return;
    const styles = getComputedStyle(grid);
    const rowH = parseFloat(styles.gridAutoRows) || 1;
    const gap = parseFloat(styles.rowGap) || 0;
    items.forEach(item => {
      if (item.hidden) return;
      const span = Math.ceil((item.getBoundingClientRect().height + gap) / (rowH + gap));
      item.style.gridRowEnd = `span ${span}`;
    });
  }
  let masonryRAF = null;
  function scheduleMasonryLayout(){
    if (masonryRAF) return;
    masonryRAF = requestAnimationFrame(() => { masonryRAF = null; layoutMasonry(); });
  }
  window.addEventListener('resize', scheduleMasonryLayout);
  // The very first layoutMasonry() call (below, inside applyFilters) runs
  // synchronously at parse time — before the title font finishes swapping
  // in. When it swaps, captions can reflow to a different height, so a card
  // ends up taller than the span it was given and visually spills into
  // whatever's below it in that column (this is what showed up as the hover
  // overlay bleeding into the next card). Recompute once fonts and the rest
  // of the page have actually settled.
  document.fonts?.ready.then(scheduleMasonryLayout);
  window.addEventListener('load', scheduleMasonryLayout);

  function sortItems(){
    const views = getViewsMap();
    const getSortKey = (item) => {
      const slug = item.dataset.slug;
      const isFree = item.dataset.free === 'true';
      const viewCount = views[slug] || 0;
      const title = item.dataset.title;
      if (state.sort === 'viewed') return [-viewCount, title];
      if (state.sort === 'recommended') return [isFree ? 0 : 1, -viewCount, title];
      // recent: preserve source order by using the item's original index
      return [items.indexOf(item)];
    };
    const sorted = [...items].sort((a, b) => {
      const ka = getSortKey(a), kb = getSortKey(b);
      for (let i = 0; i < Math.max(ka.length, kb.length); i++) {
        if (ka[i] < kb[i]) return -1;
        if (ka[i] > kb[i]) return 1;
      }
      return 0;
    });
    sorted.forEach(item => grid.appendChild(item));
  }

  function applyFilters(){
    let visible = 0;
    items.forEach(item => {
      const matchesTier = state.tier === 'all' || item.dataset.tier === state.tier;
      const matchesCategory = state.category === 'all' || item.dataset.category === state.category;
      // Search matches title, category, and tier (e.g. "studio" or "full lp"
      // finds Aethera even though neither word is in its title) — not just
      // the item name, since the search box promises full-library search.
      const matchesSearch = !state.q
        || item.dataset.title.includes(state.q)
        || item.dataset.category.toLowerCase().includes(state.q)
        || item.dataset.tier.toLowerCase().includes(state.q);
      const show = matchesTier && matchesCategory && matchesSearch;
      item.hidden = !show;
      if (show) visible++;
    });
    empty.hidden = visible > 0;
    sortItems();
    layoutMasonry();
  }

  function setFilter(type, value){
    document.querySelectorAll(`.pill[data-filter="${type}"]`).forEach(b => b.classList.remove('active'));
    const match = document.querySelector(`.pill[data-filter="${type}"][data-value="${value}"]`);
    (match || document.querySelector(`.pill[data-filter="${type}"][data-value="all"]`)).classList.add('active');
    state[type] = match ? value : 'all';
  }

  // Header copy per tier, driven only by the nav's Hero/Landing/Section
  // links (?tier=) now, no on-page tier control. Two-line headlines, kept
  // descriptive for SEO (product + tool names in the copy, not just labels).
  const HEADER_CONTENT = {
    all: { title: 'Library', badge: n => `${n} Prompts →`,
      line1: n => `${n} prompts,`, line2: 'built at the speed of thought.',
      sub: n => `${n} hero, section, and full landing page prompts, shipped from prompt to pixel with Cursor, v0, or Lovable.` },
    Hero: { title: 'Hero Prompts', badge: n => `${n} Hero Prompts →`,
      line1: n => `${n} hero prompts,`, line2: 'built at the speed of thought.',
      sub: n => `${n} hero prompts bundled with image & video assets, the first thing visitors see, engineered to convert.` },
    'Full LP': { title: 'Full Landing Page Prompts', badge: n => `${n} Full Landing Pages →`,
      line1: n => `${n} full landing pages,`, line2: 'built at the speed of thought.',
      sub: n => `${n} complete landing page prompts that generate hero, features, and CTA together, ready for Cursor, v0, or Lovable.` },
    Section: { title: 'Section Prompts', badge: n => `${n} Section Prompts →`,
      line1: n => `${n} section prompts,`, line2: 'built at the speed of thought.',
      sub: n => `${n} single-section prompts — navbars, heroes, pricing, testimonials, CTAs, and more — ready for Cursor, v0, or Lovable.` },
  };
  function updateHeader(tier){
    const cfg = HEADER_CONTENT[tier] || HEADER_CONTENT.all;
    const n = tier === 'all' ? items.length : items.filter(i => i.dataset.tier === tier).length;
    document.getElementById('catBadge').textContent = cfg.badge(n);
    document.getElementById('catHeadLine1').textContent = cfg.line1(n);
    document.getElementById('catHeadLine2').textContent = cfg.line2;
    document.getElementById('catSubhead').textContent = cfg.sub(n);
    document.title = `${cfg.title} · esprompt`;
  }

  // Category pills are scoped to whatever tier is showing. Hero only
  // ever has Hero/Testimonial items, so there's no point offering Pricing.
  const categoryScroll = document.getElementById('categoryScroll');
  function renderCategoryPills(tier){
    const pool = tier === 'all' ? items : items.filter(i => i.dataset.tier === tier);
    const cats = [...new Set(pool.map(i => i.dataset.category))].sort();
    categoryScroll.innerHTML = '<button class="pill active" data-filter="category" data-value="all">All</button>'
      + cats.map(c => `<button class="pill" data-filter="category" data-value="${c}">${c}</button>`).join('');
    categoryScroll.querySelectorAll('.pill[data-filter]').forEach(btn => {
      btn.addEventListener('click', () => { setFilter(btn.dataset.filter, btn.dataset.value); applyFilters(); });
    });
    state.category = 'all';
  }

  // Sort dropdown: recent keeps the curated source order; recommended surfaces
  // free prompts first then orders by local view count; most viewed orders by
  // local view count. All three fall back to title for ties.
  const sortBtn = document.getElementById('sortBtn');
  const sortMenu = document.getElementById('sortMenu');
  const sortLabel = document.getElementById('sortLabel');
  sortBtn.addEventListener('click', (e) => {
    e.stopPropagation();
    const open = sortMenu.hidden;
    sortMenu.hidden = !open;
    sortBtn.setAttribute('aria-expanded', String(open));
  });
  sortMenu.querySelectorAll('button[data-sort]').forEach(btn => {
    btn.addEventListener('click', () => {
      sortMenu.querySelectorAll('button').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      sortLabel.textContent = btn.textContent;
      sortMenu.hidden = true;
      sortBtn.setAttribute('aria-expanded', 'false');
      state.sort = btn.dataset.sort;
      applyFilters();
    });
  });
  document.addEventListener('click', () => {
    if (!sortMenu.hidden) { sortMenu.hidden = true; sortBtn.setAttribute('aria-expanded', 'false'); }
  });

  // Nav links (Hero/Landing/Section) pre-select a tier via ?tier=; the nav
  // search box pre-selects a query via ?q=. Both are plain URL state since
  // this is a static build, no on-page tier control to sync.
  const params = new URLSearchParams(location.search);
  const tierParam = params.get('tier');
  const activeTier = tierParam && HEADER_CONTENT[tierParam] ? tierParam : 'all';
  state.tier = activeTier;
  // Masonry is a Landing (Full LP)-only treatment — Hero and Section keep
  // the plain even-height grid.
  grid.classList.toggle('masonry', activeTier === 'Full LP');
  updateHeader(activeTier);
  renderCategoryPills(activeTier);
  const qParam = params.get('q');
  if (qParam) state.q = qParam.trim().toLowerCase();
  if (tierParam || qParam) applyFilters();

  // Copy button: gate behind auth (browse-first, gate-on-action per the agreed flow)
  grid.addEventListener('click', (e) => {
    const copyBtn = e.target.closest('.pv-btn.copy');
    if (copyBtn) {
      const doCopy = () => {
        navigator.clipboard?.writeText(espPromptText(copyBtn));
        const label = copyBtn.querySelector('span');
        const original = label.textContent;
        label.textContent = 'Copied!';
        setTimeout(() => { label.textContent = original; }, 1500);
      };
      const isFree = copyBtn.closest('.citem')?.dataset.free === 'true';
      if (isFree || (window.espHasSession && window.espHasSession())) {
        doCopy();
      } else {
        window.openAuthModal('signup', doCopy);
      }
      return;
    }
    const viewBtn = e.target.closest('.pv-btn.view');
    if (viewBtn) {
      openDetailModal(viewBtn.dataset.slug);
    }
  });

  // Quick preview modal: clones the matching hidden <template> as the
  // single source of detail markup.
  const detailOverlay = document.getElementById('detailOverlay');
  const detailBody = document.getElementById('detailModalBody');
  const detailPrev = document.getElementById('detailPrev');
  const detailNext = document.getElementById('detailNext');
  let modalSlug = null;

  function openDetailModal(slug){
    const tpl = document.getElementById(`tpl-${slug}`);
    if (!tpl) return;
    modalSlug = slug;
    incrementViews(slug);
    detailBody.innerHTML = '';
    detailBody.appendChild(tpl.content.cloneNode(true));
    detailOverlay.classList.add('open');
    document.body.style.overflow = 'hidden';
  }
  function closeDetailModal(){
    detailOverlay.classList.remove('open');
    document.body.style.overflow = '';
    detailBody.innerHTML = '';
    modalSlug = null;
  }
  // Arrows cycle through whatever is currently visible under the active
  // filters, in grid order, wrapping around at either end.
  function stepModal(dir){
    if (!modalSlug) return;
    const visible = items.filter(i => !i.hidden);
    const idx = visible.findIndex(i => i.dataset.slug === modalSlug || i.querySelector('.pv-btn.view')?.dataset.slug === modalSlug);
    if (idx === -1 || visible.length === 0) return;
    const next = visible[(idx + dir + visible.length) % visible.length];
    const slug = next.querySelector('.pv-btn.view')?.dataset.slug;
    if (slug) openDetailModal(slug);
  }
  detailPrev.addEventListener('click', () => stepModal(-1));
  detailNext.addEventListener('click', () => stepModal(1));
  // The close button now lives inside each cloned item's own topbar (see
  // PromptDetailContent.astro), so it's reached via the shared delegated
  // handler in AppLayout.astro rather than a single static listener here.
  window.closeDetailModal = closeDetailModal;
  detailOverlay.addEventListener('click', (e) => { if (e.target === detailOverlay) closeDetailModal(); });
  document.addEventListener('keydown', (e) => {
    if (!detailOverlay.classList.contains('open')) return;
    if (e.key === 'Escape') closeDetailModal();
    if (e.key === 'ArrowLeft') stepModal(-1);
    if (e.key === 'ArrowRight') stepModal(1);
  });
</script>
