---
import AppLayout from '../layouts/AppLayout.astro';
import PromptDetailContent from '../components/PromptDetailContent.astro';
import { prompts, categories } from '../data/prompts';
---
<AppLayout title="Library">
  <div class="shead reveal">
    <span class="eyebrow" id="catBadge">{prompts.length} Prompts →</span>
    <h1 class="cat-heading">
      <span id="catHeadLine1">{prompts.length} prompts,</span>
      <span id="catHeadLine2">built at the speed of thought.</span>
    </h1>
    <p id="catSubhead">{prompts.length} hero, section, and full landing page prompts, shipped from prompt to pixel with Cursor, v0, or Lovable.</p>
  </div>

  <!-- Tier switching lives in the nav (Hero/Landing/Section) — no need to
       duplicate it as an on-page control. This row is category only. -->
  <div class="catalog-controls reveal" id="catalogControls">
    <div class="pill-scroll" id="categoryScroll">
      <button class="pill active" data-filter="category" data-value="all">All</button>
      {categories.map(c => <button class="pill" data-filter="category" data-value={c}>{c}</button>)}
    </div>
    <div class="sort-dropdown" id="sortDropdown">
      <button class="sort-btn" id="sortBtn" type="button" aria-haspopup="true" aria-expanded="false">
        <span id="sortLabel">Most Recent</span>
        <svg class="lucide" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></svg>
      </button>
      <div class="sort-menu" id="sortMenu" hidden>
        <button type="button" class="active" data-sort="recent">Most Recent</button>
        <button type="button" data-sort="recommended">Recommended</button>
        <button type="button" data-sort="liked">Most Liked</button>
        <button type="button" data-sort="viewed">Most Viewed</button>
      </div>
    </div>
  </div>

  <div class="showcase-grid" id="catalogGrid">
    {prompts.map(p => (
      <div class="citem scard" data-tier={p.tier} data-category={p.category} data-title={p.title.toLowerCase()}>
        <div class="cc">
          <div class="pv" style={`background-image:url('/assets/showcase/${p.thumbnail}')`}>
            <div class="pv-overlay">
              <button class="pv-btn copy" data-prompt={p.prompt} data-slug={p.slug}>
                <svg class="lucide pv-copy-icon" viewBox="0 0 24 24"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                <span>Copy Prompt</span>
              </button>
              <button class="pv-btn ghost view" data-slug={p.slug}>
                <svg class="lucide" viewBox="0 0 24 24"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                <span>View Detail</span>
              </button>
            </div>
          </div>
        </div>
        <div class="ccap"><span class="name">{p.title}</span><span class="count">{p.tier === p.category ? p.tier : `${p.tier} - ${p.category}`}</span></div>
      </div>
    ))}
  </div>

  <p class="empty-state" id="catalogEmpty" hidden>No prompts match your search or filters.</p>
  <div class="empty-state-progress" id="catalogInProgress" hidden>
    <p>The Section tier is still in progress — check back soon.</p>
    <p>In the meantime, browse <a href="/library?tier=Full%20LP">Full Landing Page</a> or <a href="/library?tier=Hero">Hero</a> prompts.</p>
  </div>

  <!-- Pre-rendered detail content per item, kept inert inside <template> until
       cloned into the modal below. Avoids a client-side data fetch/JSON dupe. -->
  {prompts.map((p) => (
    <template id={`tpl-${p.slug}`}>
      <PromptDetailContent item={p} variant="modal" />
    </template>
  ))}

  <div class="detail-overlay" id="detailOverlay">
    <div class="detail-modal">
      <!-- Positioned relative to the modal card itself (not the viewport)
           so they sit a fixed 24px off its edges regardless of screen width. -->
      <button class="pd-arrow pd-arrow-prev" id="detailPrev" aria-label="Previous prompt">
        <svg class="lucide" viewBox="0 0 24 24"><path d="m15 18-6-6 6-6"/></svg>
      </button>
      <button class="pd-arrow pd-arrow-next" id="detailNext" aria-label="Next prompt">
        <svg class="lucide" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></svg>
      </button>
      <div id="detailModalBody"></div>
    </div>
  </div>
</AppLayout>

<style>
  /* hero-style page header — same eyebrow+headline language as the
     homepage hero, scaled down for a section (not full viewport) */
  .shead{text-align:center;max-width:800px;margin:0 auto 40px}
  .shead .eyebrow::before{background:#fff;box-shadow:0 0 6px rgba(255,255,255,.5)}
  .cat-heading{font-size:46px;font-weight:600;letter-spacing:-.03em;line-height:1.1;margin:14px 0 14px;color:#fff}
  .cat-heading span{display:block;white-space:nowrap}
  .shead p{font-size:17px;max-width:480px;margin:0 auto}
  @media(max-width:900px){ .cat-heading{font-size:30px} .cat-heading span{white-space:normal} }

  .catalog-controls{display:flex;align-items:center;gap:12px;margin-bottom:36px;position:relative;z-index:5}
  .pill-scroll{display:flex;gap:8px;overflow-x:auto;flex:1;scrollbar-width:none;padding-bottom:2px}
  .pill-scroll::-webkit-scrollbar{display:none}
  .pill-scroll .pill{flex:0 0 auto}

  .sort-dropdown{position:relative;flex:0 0 auto}
  .sort-btn{display:inline-flex;align-items:center;gap:6px;background:#fff;color:#0d0c14;border:none;
    border-radius:999px;padding:8px 14px;font-family:var(--sans);font-size:12.5px;font-weight:600;cursor:pointer;white-space:nowrap}
  .sort-btn .lucide{width:14px;height:14px;transition:transform .15s}
  .sort-btn[aria-expanded="true"] .lucide{transform:rotate(180deg)}
  .sort-menu{position:absolute;top:calc(100% + 8px);right:0;min-width:170px;background:var(--panel);
    border:1px solid var(--line2);border-radius:12px;padding:6px;display:flex;flex-direction:column;gap:2px;
    z-index:20;box-shadow:0 24px 60px -20px rgba(0,0,0,.6)}
  .sort-menu button{display:block;width:100%;text-align:left;padding:9px 11px;border-radius:8px;
    font-size:13.5px;color:var(--mut);background:none;border:none;cursor:pointer;font-family:var(--sans)}
  .sort-menu button:hover{background:rgba(255,255,255,.06);color:#fff}
  .sort-menu button.active{color:#fff}

  .empty-state{text-align:center;color:var(--mut);padding:60px 0;font-size:15px}
  .empty-state-progress{text-align:center;color:var(--mut);padding:90px 20px;font-size:15.5px;
    display:flex;flex-direction:column;gap:10px}
  .empty-state-progress a{color:var(--ink);text-decoration:underline;text-underline-offset:3px}
  .empty-state-progress a:hover{color:var(--accent,#7c5cff)}
  .citem[hidden]{display:none}
</style>

<script is:inline>
  const grid = document.getElementById('catalogGrid');
  const items = [...grid.querySelectorAll('.citem')];
  const empty = document.getElementById('catalogEmpty');
  const state = { tier: 'all', category: 'all', q: '' };

  // Copy button shows a lock while signed out (gated action) and a plain
  // clipboard once signed in, since the action isn't actually gated anymore.
  const ICON_LOCKED = '<rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>';
  const ICON_UNLOCKED = '<rect width="8" height="4" x="8" y="2" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/>';
  function updateCopyIcons(){
    const signedIn = window.espHasSession && window.espHasSession();
    document.querySelectorAll('.pv-copy-icon').forEach(svg => {
      svg.innerHTML = signedIn ? ICON_UNLOCKED : ICON_LOCKED;
    });
  }
  updateCopyIcons();
  window.addEventListener('esprompt:session-change', updateCopyIcons);

  function applyFilters(){
    let visible = 0;
    items.forEach(item => {
      const matchesTier = state.tier === 'all' || item.dataset.tier === state.tier;
      const matchesCategory = state.category === 'all' || item.dataset.category === state.category;
      const matchesSearch = !state.q || item.dataset.title.includes(state.q);
      const show = matchesTier && matchesCategory && matchesSearch;
      item.hidden = !show;
      if (show) visible++;
    });
    // Section's "no results" state is handled by applySectionInProgress
    // instead (dedicated in-progress notice, not the generic empty-state).
    if (state.tier !== 'Section') empty.hidden = visible > 0;
  }

  function setFilter(type, value){
    document.querySelectorAll(`.pill[data-filter="${type}"]`).forEach(b => b.classList.remove('active'));
    const match = document.querySelector(`.pill[data-filter="${type}"][data-value="${value}"]`);
    (match || document.querySelector(`.pill[data-filter="${type}"][data-value="all"]`)).classList.add('active');
    state[type] = match ? value : 'all';
  }

  // Header copy per tier, driven only by the nav's Hero/Landing/Section
  // links (?tier=) now, no on-page tier control. Two-line headlines, kept
  // descriptive for SEO (product + tool names in the copy, not just labels).
  const HEADER_CONTENT = {
    all: { title: 'Library', badge: n => `${n} Prompts →`,
      line1: n => `${n} prompts,`, line2: 'built at the speed of thought.',
      sub: n => `${n} hero, section, and full landing page prompts, shipped from prompt to pixel with Cursor, v0, or Lovable.` },
    Hero: { title: 'Hero Prompts', badge: n => `${n} Hero Prompts →`,
      line1: n => `${n} hero prompts,`, line2: 'built at the speed of thought.',
      sub: n => `${n} hero prompts bundled with image & video assets, the first thing visitors see, engineered to convert.` },
    'Full LP': { title: 'Full Landing Page Prompts', badge: n => `${n} Full Landing Pages →`,
      line1: n => `${n} full landing pages,`, line2: 'built at the speed of thought.',
      sub: n => `${n} complete landing page prompts that generate hero, features, and CTA together, ready for Cursor, v0, or Lovable.` },
    // No real Section prompts yet — copy is static (no counts) since "0" reads
    // as broken rather than "coming soon". Controls + empty-state get the
    // same in-progress treatment below (see hideControlsIfSection / the
    // Section branch in updateEmptyState).
    Section: { title: 'Section Prompts', badge: () => 'Section Prompts · In Progress',
      line1: () => 'Section prompts,', line2: 'still in the oven.',
      sub: () => `We're still building out this tier — pricing tables, testimonials, CTAs. Browse Hero and Full Landing Page prompts in the meantime.` },
  };
  function updateHeader(tier){
    const cfg = HEADER_CONTENT[tier] || HEADER_CONTENT.all;
    const n = tier === 'all' ? items.length : items.filter(i => i.dataset.tier === tier).length;
    document.getElementById('catBadge').textContent = cfg.badge(n);
    document.getElementById('catHeadLine1').textContent = cfg.line1(n);
    document.getElementById('catHeadLine2').textContent = cfg.line2;
    document.getElementById('catSubhead').textContent = cfg.sub(n);
    document.title = `${cfg.title} · esprompt`;
  }

  // Section tier has no real prompts yet: hide the (pointless, empty)
  // category/sort controls and grid, and show the "still in progress"
  // notice instead of the generic empty-state so users bounce to a tier
  // that actually has content rather than reading "no results".
  function applySectionInProgress(tier){
    const isSection = tier === 'Section';
    document.getElementById('catalogControls').hidden = isSection;
    grid.hidden = isSection;
    document.getElementById('catalogInProgress').hidden = !isSection;
    if (isSection) empty.hidden = true;
  }

  // Category pills are scoped to whatever tier is showing. Hero only
  // ever has Hero/Testimonial items, so there's no point offering Pricing.
  const categoryScroll = document.getElementById('categoryScroll');
  function renderCategoryPills(tier){
    const pool = tier === 'all' ? items : items.filter(i => i.dataset.tier === tier);
    const cats = [...new Set(pool.map(i => i.dataset.category))].sort();
    categoryScroll.innerHTML = '<button class="pill active" data-filter="category" data-value="all">All</button>'
      + cats.map(c => `<button class="pill" data-filter="category" data-value="${c}">${c}</button>`).join('');
    categoryScroll.querySelectorAll('.pill[data-filter]').forEach(btn => {
      btn.addEventListener('click', () => { setFilter(btn.dataset.filter, btn.dataset.value); applyFilters(); });
    });
    state.category = 'all';
  }

  // Sort dropdown: UI only for now. We don't track created-date, likes, or
  // views on mock data, so picking an option just relabels the button rather
  // than pretending to reorder by numbers we don't have.
  const sortBtn = document.getElementById('sortBtn');
  const sortMenu = document.getElementById('sortMenu');
  const sortLabel = document.getElementById('sortLabel');
  sortBtn.addEventListener('click', (e) => {
    e.stopPropagation();
    const open = sortMenu.hidden;
    sortMenu.hidden = !open;
    sortBtn.setAttribute('aria-expanded', String(open));
  });
  sortMenu.querySelectorAll('button[data-sort]').forEach(btn => {
    btn.addEventListener('click', () => {
      sortMenu.querySelectorAll('button').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      sortLabel.textContent = btn.textContent;
      sortMenu.hidden = true;
      sortBtn.setAttribute('aria-expanded', 'false');
    });
  });
  document.addEventListener('click', () => {
    if (!sortMenu.hidden) { sortMenu.hidden = true; sortBtn.setAttribute('aria-expanded', 'false'); }
  });

  // Nav links (Hero/Landing/Section) pre-select a tier via ?tier=; the nav
  // search box pre-selects a query via ?q=. Both are plain URL state since
  // this is a static build, no on-page tier control to sync.
  const params = new URLSearchParams(location.search);
  const tierParam = params.get('tier');
  const activeTier = tierParam && HEADER_CONTENT[tierParam] ? tierParam : 'all';
  state.tier = activeTier;
  updateHeader(activeTier);
  applySectionInProgress(activeTier);
  renderCategoryPills(activeTier);
  const qParam = params.get('q');
  if (qParam) state.q = qParam.trim().toLowerCase();
  if (tierParam || qParam) applyFilters();

  // Copy button: gate behind auth (browse-first, gate-on-action per the agreed flow)
  grid.addEventListener('click', (e) => {
    const copyBtn = e.target.closest('.pv-btn.copy');
    if (copyBtn) {
      const doCopy = () => {
        navigator.clipboard?.writeText(copyBtn.dataset.prompt || '');
        const label = copyBtn.querySelector('span');
        const original = label.textContent;
        label.textContent = 'Copied!';
        setTimeout(() => { label.textContent = original; }, 1500);
      };
      if (window.espHasSession && window.espHasSession()) {
        doCopy();
      } else {
        window.openAuthModal('signup', doCopy);
      }
      return;
    }
    const viewBtn = e.target.closest('.pv-btn.view');
    if (viewBtn) {
      openDetailModal(viewBtn.dataset.slug);
    }
  });

  // Quick preview modal: clones the matching hidden <template> so the
  // modal and the full /library/[slug] page render from one source.
  const detailOverlay = document.getElementById('detailOverlay');
  const detailBody = document.getElementById('detailModalBody');
  const detailPrev = document.getElementById('detailPrev');
  const detailNext = document.getElementById('detailNext');
  let modalSlug = null;

  function openDetailModal(slug){
    const tpl = document.getElementById(`tpl-${slug}`);
    if (!tpl) return;
    modalSlug = slug;
    detailBody.innerHTML = '';
    detailBody.appendChild(tpl.content.cloneNode(true));
    detailOverlay.classList.add('open');
    document.body.style.overflow = 'hidden';
  }
  function closeDetailModal(){
    detailOverlay.classList.remove('open');
    document.body.style.overflow = '';
    detailBody.innerHTML = '';
    modalSlug = null;
  }
  // Arrows cycle through whatever is currently visible under the active
  // filters, in grid order, wrapping around at either end.
  function stepModal(dir){
    if (!modalSlug) return;
    const visible = items.filter(i => !i.hidden);
    const idx = visible.findIndex(i => i.dataset.slug === modalSlug || i.querySelector('.pv-btn.view')?.dataset.slug === modalSlug);
    if (idx === -1 || visible.length === 0) return;
    const next = visible[(idx + dir + visible.length) % visible.length];
    const slug = next.querySelector('.pv-btn.view')?.dataset.slug;
    if (slug) openDetailModal(slug);
  }
  detailPrev.addEventListener('click', () => stepModal(-1));
  detailNext.addEventListener('click', () => stepModal(1));
  // The close button now lives inside each cloned item's own topbar (see
  // PromptDetailContent.astro), so it's reached via the shared delegated
  // handler in AppLayout.astro rather than a single static listener here.
  window.closeDetailModal = closeDetailModal;
  detailOverlay.addEventListener('click', (e) => { if (e.target === detailOverlay) closeDetailModal(); });
  document.addEventListener('keydown', (e) => {
    if (!detailOverlay.classList.contains('open')) return;
    if (e.key === 'Escape') closeDetailModal();
    if (e.key === 'ArrowLeft') stepModal(-1);
    if (e.key === 'ArrowRight') stepModal(1);
  });
</script>
