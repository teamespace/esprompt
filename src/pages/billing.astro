---
// Pricing itself is still TBD per the homepage FAQ ("Paid tier details are
// still being finalized and will be announced before launch") — so this
// screen deliberately doesn't invent a price for Hero. This is the "choose
// a plan" screen, not a billing-management screen: actual billing/payment
// details live on /account, not here (per explicit product decision).
import AppLayout from '../layouts/AppLayout.astro';

const CHECK = 'M20 6 9 17l-5-5';
---
<AppLayout title="Upgrade">
  <div class="shead reveal">
    <span class="eyebrow">Upgrade</span>
    <h1>Upgrade your plan.</h1>
    <p>You're on the Free plan today. This page is just for picking a plan; billing and subscription details live in your <a href="/account">Account</a> page.</p>
  </div>

  <div class="plan-grid reveal">
    <div class="plan-card">
      <div class="plan-top">
        <h3>Free</h3>
        <div class="plan-price">$0<span>/mo</span></div>
        <p class="plan-caption">Free, forever</p>
      </div>
      <p class="plan-desc">Best for trying esprompt: browse the whole catalog and copy every Section &amp; Full LP prompt.</p>
      <a class="btn ghost plan-cta" href="/catalog">Browse catalog</a>
      <div class="plan-list">
        <span class="plan-list-label">Included</span>
        <ul>
          <li><svg class="lucide" viewBox="0 0 24 24"><path d={CHECK}/></svg>Browse and search the whole catalog</li>
          <li><svg class="lucide" viewBox="0 0 24 24"><path d={CHECK}/></svg>Copy Section &amp; Full LP prompts</li>
          <li><svg class="lucide" viewBox="0 0 24 24"><path d={CHECK}/></svg>Community support</li>
        </ul>
      </div>
    </div>

    <div class="plan-card accent">
      <span class="plan-badge">Coming soon</span>
      <div class="plan-top">
        <h3>Hero</h3>
        <div class="plan-price">Coming soon</div>
        <p class="plan-caption">Pricing to be announced</p>
      </div>
      <p class="plan-desc">For teams and power users who want Hero image &amp; video assets and priority support.</p>
      <button class="btn primary plan-cta" id="notifyBtn" type="button">Notify me</button>
      <div class="plan-list">
        <span class="plan-list-label">Everything in Free, plus</span>
        <ul>
          <li><svg class="lucide" viewBox="0 0 24 24"><path d={CHECK}/></svg>Image &amp; video assets for Hero items</li>
          <li><svg class="lucide" viewBox="0 0 24 24"><path d={CHECK}/></svg>Priority support</li>
          <li><svg class="lucide" viewBox="0 0 24 24"><path d={CHECK}/></svg>Early access to new tiers</li>
        </ul>
      </div>
    </div>
  </div>

  <div class="shead faq-head reveal">
    <span class="eyebrow">FAQ</span>
    <h2>Pricing and billing, answered.</h2>
  </div>

  <div class="faq reveal">
    <details class="q" open>
      <summary><span>Is esprompt really free to use?</span><span class="plus">+</span></summary>
      <p>Yes. Browsing the catalog and copying Section &amp; Full LP prompts is free, no card required.</p>
    </details>
    <details class="q">
      <summary><span>What do I get with the paid plan?</span><span class="plus">+</span></summary>
      <p>Hero-tier prompts ship with downloadable image &amp; video assets, plus priority support once pricing is live.</p>
    </details>
    <details class="q">
      <summary><span>When will paid pricing be announced?</span><span class="plus">+</span></summary>
      <p>We're still finalizing it. Hit "Notify me" above and you'll be the first to know when it's live.</p>
    </details>
    <details class="q">
      <summary><span>Will I be charged automatically?</span><span class="plus">+</span></summary>
      <p>No surprise charges. Once paid plans launch, you'll confirm a plan and payment method before anything is billed.</p>
    </details>
    <details class="q">
      <summary><span>What payment methods will you accept?</span><span class="plus">+</span></summary>
      <p>Major credit and debit cards at launch, with more options added over time.</p>
    </details>
    <details class="q">
      <summary><span>Can I cancel anytime?</span><span class="plus">+</span></summary>
      <p>Yes. You'll be able to cancel anytime from Account, no lock-in or long-term commitment.</p>
    </details>
    <details class="q">
      <summary><span>Do you offer refunds?</span><span class="plus">+</span></summary>
      <p>Our refund policy will be published alongside pricing so you know the terms before you pay.</p>
    </details>
    <details class="q">
      <summary><span>Can I switch plans later?</span><span class="plus">+</span></summary>
      <p>Yes. You'll be able to upgrade or downgrade anytime from Account, and changes apply on your next billing cycle.</p>
    </details>
    <details class="q">
      <summary><span>Where do I manage billing and my subscription?</span><span class="plus">+</span></summary>
      <p>That lives in your <a href="/account">Account</a> page, not here. This page is just for choosing a plan.</p>
    </details>
    <details class="q">
      <summary><span>Which AI tools does it work with?</span><span class="plus">+</span></summary>
      <p>All popular AI coding tools: Cursor, v0, Lovable, Claude, Bolt, Windsurf, and more.</p>
    </details>
  </div>
</AppLayout>

<style>
  .shead p a{color:#fff;text-decoration:underline}
  .faq-head{margin-bottom:36px}
  @property --bangle{syntax:'<angle>';inherits:false;initial-value:0deg}
  .plan-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:22px;max-width:820px;margin:0 auto 80px}
  .plan-card{border:1px solid var(--line2);border-radius:20px;padding:32px;background:var(--panel);position:relative;display:flex;flex-direction:column}
  .plan-card.accent{border-color:transparent;background:linear-gradient(160deg,rgba(168,85,247,.18),var(--panel) 60%);box-shadow:0 34px 80px -36px var(--v)}
  .plan-card.accent::before{content:"";position:absolute;inset:0;border-radius:20px;padding:1.5px;pointer-events:none;
    background:conic-gradient(from var(--bangle,0deg),transparent 0deg,transparent 265deg,var(--b) 300deg,var(--v2) 328deg,transparent 355deg);
    -webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;mask-composite:exclude;
    animation:planCtaBorder 5s linear infinite}
  @keyframes planCtaBorder{to{--bangle:360deg}}
  .plan-badge{position:absolute;top:-12px;right:24px;background:#fff;color:#0d0c14;
    font-size:11px;font-weight:600;padding:5px 13px;border-radius:999px;font-family:var(--mono)}
  .plan-top h3{font-size:18px;font-weight:600;color:#fff;margin-bottom:10px}
  .plan-price{font-size:38px;font-weight:600;letter-spacing:-.02em;color:#fff;line-height:1}
  .plan-price span{font-size:16px;font-weight:500;color:var(--mut)}
  .plan-caption{font-size:13px;color:var(--dim);margin-top:8px}
  .plan-desc{color:var(--mut);font-size:14.5px;line-height:1.6;margin:20px 0 22px}
  .plan-cta{width:100%;justify-content:center;margin-bottom:26px}
  .plan-list{border-top:1px solid var(--line);padding-top:20px;margin-top:auto}
  .plan-list-label{font-family:var(--mono);font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:var(--dim);display:block;margin-bottom:14px}
  .plan-list ul{list-style:none;display:grid;gap:11px}
  .plan-list li{display:flex;align-items:flex-start;gap:10px;color:var(--mut);font-size:14.5px;line-height:1.4}
  .plan-list li .lucide{width:15px;height:15px;color:var(--v);flex:0 0 auto;margin-top:2px}

  .faq{max-width:760px;margin:0 auto;border-top:1px solid var(--line)}
  .faq .q{border-bottom:1px solid var(--line)}
  .faq .q summary{list-style:none;cursor:pointer;padding:24px 4px;font-weight:600;font-size:17px;color:#fff;
    letter-spacing:-.01em;display:flex;justify-content:space-between;align-items:center;gap:20px}
  .faq .q summary::-webkit-details-marker{display:none}
  .faq .q summary .plus{color:var(--dim);font-weight:300;font-size:22px;line-height:1;transition:transform .25s;flex:0 0 auto}
  .faq .q[open] summary .plus{transform:rotate(45deg)}
  .faq .q p{padding:0 4px 24px;color:var(--mut);font-size:15px;line-height:1.7;max-width:620px}
  .faq .q p a{color:#fff;text-decoration:underline}

  @media(max-width:760px){ .plan-grid{grid-template-columns:1fr} }
</style>

<script is:inline>
  document.getElementById('notifyBtn').addEventListener('click', (e) => {
    e.target.textContent = "You're on the list!";
    e.target.disabled = true;
  });
</script>
