---
// Two paid tiers only, no free plan: Yearly (subscription) and Lifetime
// NOTE: prices and plan copy here are mirrored on the homepage pricing
// section (src/pages/index.astro, #harga). Change one, change the other.
// (one-time, discounted launch price, marked Most Popular). Pricing is set
// for esprompt's actual audience — non-technical founders, students,
// vibe coders/indie hackers, marketers — a price-sensitive, prosumer group,
// not enterprise buyers. This is the "choose a plan" screen, not a
// billing-management screen: actual billing/payment details live on
// /account, not here (per explicit product decision).
import AppLayout from '../layouts/AppLayout.astro';

const CHECK = 'M20 6 9 17l-5-5';
---
<AppLayout title="Upgrade">
  <div class="shead reveal">
    <span class="eyebrow">Upgrade</span>
    <h1>Upgrade your plan.</h1>
    <p>Browsing the library is free. Pick a plan below to unlock copying every Hero &amp; Full LP prompt; billing and subscription details live in your <a href="/account">Account</a> page.</p>
  </div>

  <div class="plan-grid reveal">
    <div class="plan-card">
      <div class="plan-top">
        <h3>Yearly Access</h3>
        <p class="plan-caption plan-caption-top">Unlimited prompt access, billed annually</p>
        <div class="plan-price">$49<span>/yr</span></div>
        <p class="plan-caption">Per year, cancel anytime</p>
      </div>
      <button class="btn primary plan-cta" id="yearlyBtn" type="button">Subscribe Yearly</button>
      <div class="plan-list">
        <span class="plan-list-label">Included</span>
        <ul>
          <li><svg class="lucide" viewBox="0 0 24 24"><path d={CHECK}/></svg>Unlimited Hero &amp; Full LP prompts</li>
          <li><svg class="lucide" viewBox="0 0 24 24"><path d={CHECK}/></svg>Hero image &amp; video assets</li>
          <li><svg class="lucide" viewBox="0 0 24 24"><path d={CHECK}/></svg>Instant access to the full library</li>
          <li><svg class="lucide" viewBox="0 0 24 24"><path d={CHECK}/></svg>New prompts added monthly</li>
          <li><svg class="lucide" viewBox="0 0 24 24"><path d={CHECK}/></svg>Community support</li>
          <li><svg class="lucide" viewBox="0 0 24 24"><path d={CHECK}/></svg>Priority support</li>
        </ul>
      </div>
    </div>

    <div class="plan-card accent">
      <div class="plan-top">
        <h3>Lifetime Access <span class="badge-pop">Most Popular</span></h3>
        <p class="plan-caption plan-caption-top">Unlimited prompt access, forever</p>
        <div class="plan-price"><span class="was">$199</span> $89</div>
        <p class="plan-caption">One-time payment, lifetime access</p>
      </div>
      <button class="btn primary plan-cta grad-cta" id="lifetimeBtn" type="button">Pay Once, Access Forever</button>
      <div class="plan-list">
        <span class="plan-list-label">Everything in Yearly, plus</span>
        <ul>
          <li><svg class="lucide" viewBox="0 0 24 24"><path d={CHECK}/></svg>Lifetime updates, no renewals</li>
          <li><svg class="lucide" viewBox="0 0 24 24"><path d={CHECK}/></svg>Early access to new prompts &amp; features</li>
          <li><svg class="lucide" viewBox="0 0 24 24"><path d={CHECK}/></svg>Locked-in launch price</li>
        </ul>
      </div>
    </div>
  </div>

  <div class="shead faq-head reveal">
    <span class="eyebrow">FAQ</span>
    <h2>Pricing and billing, answered.</h2>
  </div>

  <div class="faq reveal">
    <details class="q" open>
      <summary><span>Is esprompt free to use?</span><span class="plus">+</span></summary>
      <p>Browsing and searching the library is free, no card required. Copying Hero &amp; Full LP prompts needs a Yearly or Lifetime plan.</p>
    </details>
    <details class="q">
      <summary><span>What's the difference between Yearly and Lifetime?</span><span class="plus">+</span></summary>
      <p>Both unlock the full library and Hero image &amp; video assets. Yearly renews annually; Lifetime is a single one-time payment for permanent access at today's launch price.</p>
    </details>
    <details class="q">
      <summary><span>Should I pick Yearly or Lifetime?</span><span class="plus">+</span></summary>
      <p>If you'll use esprompt for more than about two years, Lifetime pays for itself. If you just want it for one project, Yearly is the lighter commitment.</p>
    </details>
    <details class="q">
      <summary><span>Will I be charged automatically?</span><span class="plus">+</span></summary>
      <p>No surprise charges. You'll confirm your plan and payment method before anything is billed.</p>
    </details>
    <details class="q">
      <summary><span>What payment methods will you accept?</span><span class="plus">+</span></summary>
      <p>Major credit and debit cards at launch, with more options added over time.</p>
    </details>
    <details class="q">
      <summary><span>Can I cancel anytime?</span><span class="plus">+</span></summary>
      <p>Yes. You'll be able to cancel anytime from Account, no lock-in or long-term commitment.</p>
    </details>
    <details class="q">
      <summary><span>Do you offer refunds?</span><span class="plus">+</span></summary>
      <p>Our refund policy will be published alongside pricing so you know the terms before you pay.</p>
    </details>
    <details class="q">
      <summary><span>Can I switch plans later?</span><span class="plus">+</span></summary>
      <p>Yes. You'll be able to upgrade or downgrade anytime from Account, and changes apply on your next billing cycle.</p>
    </details>
    <details class="q">
      <summary><span>Where do I manage billing and my subscription?</span><span class="plus">+</span></summary>
      <p>That lives in your <a href="/account">Account</a> page, not here. This page is just for choosing a plan.</p>
    </details>
    <details class="q">
      <summary><span>Which AI tools does it work with?</span><span class="plus">+</span></summary>
      <p>All popular AI coding tools: Cursor, v0, Lovable, Claude, Bolt, Windsurf, and more.</p>
    </details>
  </div>
</AppLayout>

<style>
  .shead p a{color:#fff;text-decoration:underline}
  .faq-head{margin-bottom:36px}
  @property --bangle{syntax:'<angle>';inherits:false;initial-value:0deg}
  .plan-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:22px;max-width:820px;margin:0 auto 80px}
  .plan-card{border:1px solid var(--line2);border-radius:20px;padding:32px;background:var(--panel);position:relative;display:flex;flex-direction:column}
  .plan-card.accent{border-color:transparent;background:linear-gradient(160deg,rgba(168,85,247,.18),var(--panel) 60%);box-shadow:0 34px 80px -36px var(--v)}
  .plan-card.accent::before{content:"";position:absolute;inset:0;border-radius:20px;padding:1.5px;pointer-events:none;
    background:conic-gradient(from var(--bangle,0deg),transparent 0deg,transparent 265deg,var(--b) 300deg,var(--v2) 328deg,transparent 355deg);
    -webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;mask-composite:exclude;
    animation:planCtaBorder 5s linear infinite}
  @keyframes planCtaBorder{to{--bangle:360deg}}
  .plan-top h3{font-size:18px;font-weight:600;color:#fff;margin-bottom:10px;display:flex;align-items:center;gap:10px;flex-wrap:wrap}
  .badge-pop{font-family:var(--mono);font-size:10.5px;font-weight:700;letter-spacing:.03em;color:#fff;
    background:linear-gradient(100deg,var(--v),var(--p) 48%,var(--b));border-radius:999px;padding:4px 10px;line-height:1}
  .plan-caption-top{margin:0 0 18px}
  .plan-price{font-size:38px;font-weight:600;letter-spacing:-.02em;color:#fff;line-height:1}
  .plan-price span{font-size:16px;font-weight:500;color:var(--mut)}
  .plan-price .was{font-size:22px;font-weight:500;color:var(--dim);text-decoration:line-through;margin-right:8px}
  .plan-caption{font-size:13px;color:var(--dim);margin-top:8px}
  .plan-cta{width:100%;justify-content:center;margin-top:26px;margin-bottom:26px}
  .grad-cta{background:linear-gradient(100deg,var(--v),var(--p) 48%,var(--b));color:#fff;box-shadow:0 10px 30px -12px rgba(168,85,247,.5)}
  .grad-cta:hover{transform:translateY(-2px);box-shadow:0 14px 36px -12px rgba(168,85,247,.65)}
  .plan-list{border-top:1px solid var(--line);padding-top:20px;margin-top:auto}
  .plan-list-label{font-family:var(--mono);font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:var(--dim);display:block;margin-bottom:14px}
  .plan-list ul{list-style:none;display:grid;gap:11px}
  .plan-list li{display:flex;align-items:flex-start;gap:10px;color:var(--mut);font-size:14.5px;line-height:1.4}
  .plan-list li .lucide{width:15px;height:15px;color:var(--v);flex:0 0 auto;margin-top:2px}

  .faq{max-width:760px;margin:0 auto;border-top:1px solid var(--line)}
  .faq .q{border-bottom:1px solid var(--line)}
  .faq .q summary{list-style:none;cursor:pointer;padding:24px 4px;font-weight:600;font-size:17px;color:#fff;
    letter-spacing:-.01em;display:flex;justify-content:space-between;align-items:center;gap:20px}
  .faq .q summary::-webkit-details-marker{display:none}
  .faq .q summary .plus{color:var(--dim);font-weight:300;font-size:22px;line-height:1;transition:transform .25s;flex:0 0 auto}
  .faq .q[open] summary .plus{transform:rotate(45deg)}
  .faq .q p{padding:0 4px 24px;color:var(--mut);font-size:15px;line-height:1.7;max-width:620px}
  .faq .q p a{color:#fff;text-decoration:underline}

  @media(max-width:760px){ .plan-grid{grid-template-columns:1fr} }
</style>

<script is:inline>
  document.getElementById('yearlyBtn').addEventListener('click', (e) => {
    e.target.textContent = "You're subscribed!";
    e.target.disabled = true;
  });
  document.getElementById('lifetimeBtn').addEventListener('click', (e) => {
    e.target.textContent = "You're in, for life!";
    e.target.disabled = true;
  });
</script>
