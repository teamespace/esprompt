<script is:inline>
  /* scroll reveal: fade+rise elements in as each section enters view */
  const revealEls=[...document.querySelectorAll([
    '.hero .eyebrow','.hero h1','.hero .lead','.hero .heroctas',
    '#features .shead','#features .fcard',
    '#tier .shead','#tier .citem.scard','#tier .showcase-cta',
    '#how .how-left > *','#how .how-right',
    '#why .why-left','#why .why-row',
    '#faq .shead','#faq .q',
    '#harga .bigcta',
    'footer .foot-brand','footer .foot-col','footer .foot-bottom'
  ].join(','))];
  const revealSet=new Set(revealEls);
  revealEls.forEach(el=>{
    el.classList.add('reveal');
    const sibs=[...el.parentElement.children].filter(c=>revealSet.has(c));
    el.style.transitionDelay=(Math.min(sibs.indexOf(el),6)*110)+'ms';
  });
  const revealIO=new IntersectionObserver((entries)=>{
    entries.forEach(entry=>{
      if(entry.isIntersecting){entry.target.classList.add('in');revealIO.unobserve(entry.target)}
    });
  },{threshold:.12,rootMargin:'0px 0px -40px 0px'});
  revealEls.forEach(el=>revealIO.observe(el));

  /* nav: transparent over hero, solid once scrolled */
  const navEl=document.querySelector('nav');
  function onScroll(){navEl.classList.toggle('scrolled',window.scrollY>24)}
  window.addEventListener('scroll',onScroll,{passive:true});
  onScroll();
  /* seamless carousel: duplicate the track content once */
  const track=document.getElementById('track');
  track.innerHTML+=track.innerHTML;

  /* ===== features section: coverflow of component screenshots ===== */
  const fhFlow=document.getElementById('fhFlow');
  if(fhFlow){
    const fhImgs=['proxim','luma','arlo','stillwave','apex','altr','aura','elan','vris-r1','vox'];
    fhFlow.innerHTML=fhImgs.map(n=>`<div class="fh-slide" style="background-image:url('/assets/showcase/${n}.png')"></div>`).join('');
    const fhSlides=[...fhFlow.children];
    let fhActive=0;
    function fhRender(){
      const n=fhSlides.length;
      fhSlides.forEach((s,i)=>{
        let off=i-fhActive;
        if(off>n/2)off-=n; if(off<-n/2)off+=n;
        const abs=Math.abs(off);
        if(abs>1){s.style.opacity=0;s.style.transform=`translate(-50%,-50%) translateX(${off*335}px) scale(.6)`;s.style.zIndex=0;return}
        const x=off*335,rot=off*-35,scale=abs?.8:1,op=abs?.7:1;
        s.style.transform=`translate(-50%,-50%) translateX(${x}px) rotateY(${rot}deg) scale(${scale})`;
        s.style.opacity=op;s.style.zIndex=10-abs;
      });
    }
    fhRender();
    setInterval(()=>{fhActive=(fhActive+1)%fhSlides.length;fhRender()},2200);
  }
  const searchEl=document.getElementById('searchType');
  if(searchEl){
    const queries=['aurora hero','pricing section','web3 landing page','fintech hero'];
    let qi=0;
    function typeQuery(){
      const q=queries[qi%queries.length];let j=0;
      (function t(){if(j<=q.length){searchEl.textContent=q.slice(0,j);j++;setTimeout(t,55)}else{setTimeout(erase,1400)}})();
      function erase(){if(j>0){j--;searchEl.textContent=q.slice(0,j);setTimeout(erase,28)}else{qi++;setTimeout(typeQuery,400)}}
    }
    typeQuery();
  }
  const resrows=document.getElementById('resrows');
  if(resrows){
    setInterval(()=>{[...resrows.children].forEach(r=>{r.style.animation='none';void r.offsetWidth;r.style.animation=''})},5200);
  }
  /* ===== how-it-works: step 1, scrolling component library ===== */
  const hpLibTrack=document.getElementById('hpLibTrack');
  if(hpLibTrack){
    const hpLibImgs=['proxim','luma','arlo','stillwave','apex','altr','aura','elan','candor'];
    const cards=hpLibImgs.map(n=>`<div class="hp-lib-card" style="background-image:url('/assets/showcase/${n}.png')">
      <div class="hp-lib-ov"><button class="hp-lib-btn ghost" data-alt="Lihat">View</button><button class="hp-lib-btn" data-alt="Copy">Copy</button></div>
    </div>`).join('');
    hpLibTrack.innerHTML=cards+cards;

    /* fake cursor wanders to a real card and "touches" it to reveal the overlay */
    const hpLibEl=hpLibTrack.parentElement;
    const hpCursor=hpLibEl.querySelector('.hp-lib-cursor');
    let hpTouched=null;
    function hpCursorTick(){
      const libRect=hpLibEl.getBoundingClientRect();
      const visible=[...hpLibTrack.children].filter(c=>{
        const r=c.getBoundingClientRect();
        return r.top>=libRect.top+20&&r.bottom<=libRect.bottom-20;
      });
      if(!visible.length)return;
      const card=visible[Math.floor(Math.random()*visible.length)];
      const r=card.getBoundingClientRect();
      hpCursor.style.left=(r.left-libRect.left+r.width/2-10)+'px';
      hpCursor.style.top=(r.top-libRect.top+r.height/2-10)+'px';
      hpCursor.classList.add('show');
      if(hpTouched)hpTouched.classList.remove('touch');
      card.classList.add('touch');
      hpTouched=card;
    }
    hpCursorTick();
    setInterval(hpCursorTick,1800);
  }

  /* ===== how-it-works: step 2, cursor walks up and clicks copy ===== */
  const hpCopyCard=document.getElementById('hpCopyCard');
  const hpCopyBtn=document.getElementById('hpCopyBtn');
  const hpCopyCursor=document.getElementById('hpCopyCursor');
  if(hpCopyCard&&hpCopyBtn&&hpCopyCursor){
    const hpCopyEl=hpCopyCard.parentElement;
    function hpCopyCycle(){
      const boxRect=hpCopyEl.getBoundingClientRect();
      const btnRect=hpCopyBtn.getBoundingClientRect();
      const targetLeft=btnRect.right-boxRect.left-4;
      const targetTop=btnRect.bottom-boxRect.top-4;
      hpCopyCursor.style.transition='none';
      hpCopyCursor.style.left=targetLeft+'px';
      hpCopyCursor.style.top=(boxRect.height+16)+'px';
      hpCopyCursor.classList.add('show');
      void hpCopyCursor.offsetHeight;
      hpCopyCursor.style.transition='';
      requestAnimationFrame(()=>{hpCopyCursor.style.top=targetTop+'px'});
      setTimeout(()=>{
        hpCopyCursor.classList.add('click');
        hpCopyCard.classList.add('zoom');
        hpCopyBtn.textContent=ALT?'Tersalin ✓':'Copied ✓';hpCopyBtn.classList.add('copied');
        setTimeout(()=>hpCopyCursor.classList.remove('click'),150);
      },700);
      setTimeout(()=>{
        hpCopyCard.classList.remove('zoom');
        hpCopyBtn.textContent=ALT?'Salin prompt':'Copy prompt';hpCopyBtn.classList.remove('copied');
      },2200);
    }
    hpCopyCycle();
    setInterval(hpCopyCycle,4200);
  }

  /* ===== how-it-works: step 3, cursor pastes into editor, then clicks generate ===== */
  const hpEditorLines=document.getElementById('hpEditorLines');
  const hpGenBtn=document.getElementById('hpGenBtn');
  const hpGenResult=document.getElementById('hpGenResult');
  const hpGenCursor=document.getElementById('hpGenCursor');
  if(hpEditorLines&&hpGenBtn&&hpGenResult&&hpGenCursor){
    const hpPromptLines=['Create a modern hero section','with a soft aurora gradient,','bold two-line headline…'];
    const hpGenEl=hpEditorLines.closest('.hp-gen');
    function hpRenderLines(filled){
      hpEditorLines.innerHTML=hpPromptLines.map((t,i)=>
        `<div class="hpe-line"><span class="hpe-ln">${i+1}</span><span class="hpe-txt${filled?'':' skel'}">${filled?t:''}</span></div>`
      ).join('');
    }
    function hpGenCycle(){
      hpRenderLines(false);
      hpGenResult.classList.remove('show');
      hpGenBtn.classList.remove('active');

      const boxRect=hpGenEl.getBoundingClientRect();
      const codeRect=hpEditorLines.getBoundingClientRect();
      const codeLeft=codeRect.left-boxRect.left+codeRect.width/2-10;
      const codeTop=codeRect.top-boxRect.top+codeRect.height/2-10;
      hpGenCursor.style.transition='none';
      hpGenCursor.style.left=codeLeft+'px';
      hpGenCursor.style.top=(boxRect.height+16)+'px';
      hpGenCursor.classList.add('show');
      void hpGenCursor.offsetHeight;
      hpGenCursor.style.transition='';
      requestAnimationFrame(()=>{hpGenCursor.style.top=codeTop+'px'});

      setTimeout(()=>{
        hpRenderLines(true);
        const lines=hpEditorLines.querySelectorAll('.hpe-line');
        lines.forEach(l=>l.classList.add('flash'));
        setTimeout(()=>lines.forEach(l=>l.classList.remove('flash')),500);
      },700);

      setTimeout(()=>{
        const boxRect2=hpGenEl.getBoundingClientRect();
        const btnRect=hpGenBtn.getBoundingClientRect();
        hpGenCursor.style.left=(btnRect.right-boxRect2.left-4)+'px';
        hpGenCursor.style.top=(btnRect.bottom-boxRect2.top-4)+'px';
      },1600);

      setTimeout(()=>{
        hpGenCursor.classList.add('click');
        hpGenBtn.classList.add('active');
        setTimeout(()=>hpGenCursor.classList.remove('click'),150);
      },2300);

      setTimeout(()=>{hpGenResult.classList.add('show')},2500);
      setTimeout(hpGenCycle,6200);
    }
    hpGenCycle();
  }

  /* ===== how-it-works: auto-advancing tabs ===== */
  const howStepsEls=[...document.querySelectorAll('#howSteps .how-step')];
  const howPanelEls=[...document.querySelectorAll('.how-panel')];
  const HOW_STEP_MS=4200;
  let howIdx=0,howTimer=null;
  function howActivate(idx){
    howIdx=idx;
    howStepsEls.forEach((el,i)=>{
      el.classList.toggle('active',i===idx);
      const fill=el.querySelector('.how-fill');
      fill.style.transition='none';fill.style.transform='scaleY(0)';
      if(i===idx){
        void fill.offsetHeight;
        fill.style.transition=`transform ${HOW_STEP_MS}ms linear`;
        requestAnimationFrame(()=>{fill.style.transform='scaleY(1)'});
      }
    });
    howPanelEls.forEach((p,i)=>p.classList.toggle('active',p.id===howStepsEls[idx].dataset.panel));
  }
  function howCycle(){
    howActivate(howIdx);
    clearTimeout(howTimer);
    howTimer=setTimeout(()=>{howIdx=(howIdx+1)%howStepsEls.length;howCycle();},HOW_STEP_MS);
  }
  if(howStepsEls.length){
    howStepsEls.forEach((el,i)=>el.addEventListener('click',()=>{clearTimeout(howTimer);howIdx=i;howCycle();}));
    howCycle();
    const howRightEl=document.querySelector('.how-right');
    howRightEl.addEventListener('mouseenter',()=>clearTimeout(howTimer));
    howRightEl.addEventListener('mouseleave',()=>howCycle());
  }

  /* tools-fly: swap sticky headline as the user scrolls through the pinned section */
  const toolsSection=document.querySelector('.tools-fly');
  if(toolsSection){
    const tfMsgs=[...toolsSection.querySelectorAll('.tf-msg')];
    function onToolsScroll(){
      const rect=toolsSection.getBoundingClientRect();
      const runway=rect.height-window.innerHeight;
      const progress=runway>0?Math.min(1,Math.max(0,-rect.top/runway)):0;
      const idx=Math.min(tfMsgs.length-1,Math.floor(progress*tfMsgs.length));
      tfMsgs.forEach((m,i)=>m.classList.toggle('active',i===idx));
    }
    window.addEventListener('scroll',onToolsScroll,{passive:true});
    onToolsScroll();
  }

  /* language */
  let ALT=false;
  const nodes=[...document.querySelectorAll('[data-alt]')];
  nodes.forEach(n=>n.dataset.en=n.innerHTML);
  function toggleLang(){ALT=!ALT;nodes.forEach(n=>n.innerHTML=ALT?n.dataset.alt:n.dataset.en);
    document.querySelectorAll('.lang-switch').forEach(l=>l.classList.toggle('alt',ALT));
    document.documentElement.lang=ALT?'id':'en';}

  function openAuthModal(mode){
    setAuthMode(mode||'signup');
    document.getElementById('authOverlay').classList.add('open');
    document.body.style.overflow='hidden';
  }
  function closeAuthModal(){
    document.getElementById('authOverlay').classList.remove('open');
    document.body.style.overflow='';
  }
  document.addEventListener('keydown',e=>{if(e.key==='Escape')closeAuthModal();});

  function toggleAmPw(){
    const pw=document.getElementById('amPw');
    const isPw=pw.type==='password';
    pw.type=isPw?'text':'password';
    document.getElementById('amPwIcon').innerHTML=isPw
      ?'<path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/>'
      :'<path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/><path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/><path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/><line x1="2" x2="22" y1="2" y2="22"/>';
  }
  function fillDemoAccount(){
    document.getElementById('amEmail').value='demo@esprompt.com';
    document.getElementById('amPw').value='demo1234';
  }
  function setAuthMode(mode){
    const isLogin=mode==='login';
    document.getElementById('amNameRow').style.display=isLogin?'none':'grid';
    document.getElementById('amPwHint').style.display=isLogin?'none':'block';
    document.getElementById('amDemoHint').hidden=!isLogin;
    const title=document.getElementById('amTitle'), sub=document.getElementById('amSub'), btn=document.getElementById('amSubmitBtn'), sw=document.getElementById('amSwitch');
    title.textContent=ALT?(isLogin?'Selamat balik':'Bikin akun kamu'):(isLogin?'Welcome back':'Create your account');
    title.dataset.en=isLogin?'Welcome back':'Create your account';
    title.dataset.alt=isLogin?'Selamat balik':'Bikin akun kamu';
    sub.textContent=ALT?(isLogin?'Masuk ke akun esprompt kamu.':'Isi data kamu buat mulai.'):(isLogin?'Log in to your esprompt account.':'Enter your details to get started.');
    sub.dataset.en=isLogin?'Log in to your esprompt account.':'Enter your details to get started.';
    sub.dataset.alt=isLogin?'Masuk ke akun esprompt kamu.':'Isi data kamu buat mulai.';
    btn.textContent=ALT?(isLogin?'Masuk':'Daftar'):(isLogin?'Log in':'Sign up');
    btn.dataset.en=isLogin?'Log in':'Sign up';
    btn.dataset.alt=isLogin?'Masuk':'Daftar';
    const swEn=isLogin?'Don’t have an account? <a onclick="setAuthMode(\'signup\')">Sign up</a>':'Already have an account? <a onclick="setAuthMode(\'login\')">Log in</a>';
    const swAlt=isLogin?'Belum punya akun? <a onclick="setAuthMode(\'signup\')">Daftar</a>':'Udah punya akun? <a onclick="setAuthMode(\'login\')">Masuk</a>';
    sw.innerHTML=ALT?swAlt:swEn; sw.dataset.en=swEn; sw.dataset.alt=swAlt;
  }
</script>
</body>
</html>
