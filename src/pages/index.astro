<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>esprompt · Prompts into UI (Version C · Gradient / Reactbits-style)</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style is:global>
  @font-face{font-family:'Pixelbasel';src:url('/assets/pixelbasel/Pixelbasel.ttf') format('truetype');font-weight:400;font-display:swap}
  :root{
    --bg:#050409; --bg2:#0b0a13; --panel:#100f19; --panel2:#16152340;
    --line:#1d1c2a; --line2:#2a2839;
    --ink:#f4f4fa; --mut:#a0a2b6; --dim:#63647c;
    --v:#a855f7; --v2:#9333ea; --p:#7c3aed; --b:#c084fc; --c:#38d6cf;
    --sans:'Inter Tight',system-ui,sans-serif; --mono:'JetBrains Mono',monospace;
    --pixel:'Pixelbasel',var(--mono);
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth}
  body{background:var(--bg);color:var(--ink);font-family:var(--sans);font-weight:500;line-height:1.6;-webkit-font-smoothing:antialiased;letter-spacing:-.015em;overflow-x:hidden}
  .wrap{max-width:1200px;margin:0 auto;padding:0 28px}
  .reveal{opacity:0;transform:translateY(34px);transition:opacity 1.2s cubic-bezier(.16,1,.3,1),transform 1.2s cubic-bezier(.16,1,.3,1)}
  .reveal.in{opacity:1;transform:translateY(0)}
  @media(prefers-reduced-motion:reduce){.reveal{transition:none;opacity:1;transform:none}}
  a{color:inherit;text-decoration:none}
  .lucide{width:14px;height:14px;flex:0 0 auto;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
  section{scroll-margin-top:90px}
  .grad{background:linear-gradient(100deg,var(--v),var(--p) 48%,var(--b));-webkit-background-clip:text;background-clip:text;color:transparent}
  .btn{display:inline-flex;align-items:center;gap:8px;font-weight:600;font-size:15px;border-radius:999px;padding:12px 22px;transition:.18s;cursor:pointer;border:1px solid transparent}
  .btn.primary{background:#fff;color:#0d0c14;box-shadow:0 10px 30px -12px rgba(255,255,255,.3)}
  .btn.primary:hover{transform:translateY(-2px);box-shadow:0 14px 36px -12px rgba(255,255,255,.45)}
  .btn.ghost{background:rgba(255,255,255,.04);border-color:var(--line2);color:var(--ink)}
  .btn.ghost:hover{background:rgba(255,255,255,.08);border-color:var(--v)}
  .eyebrow{font-family:var(--pixel);font-size:15px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#fff;
    display:inline-flex;align-items:center;gap:8px}
  .eyebrow::before{content:"";width:6px;height:6px;border-radius:50%;background:var(--v);flex:0 0 auto;box-shadow:0 0 6px rgba(168,85,247,.7)}
  nav{position:fixed;top:0;left:0;right:0;z-index:50;background:transparent;backdrop-filter:none;border-bottom:1px solid transparent;transition:background .25s,backdrop-filter .25s,border-color .25s}
  nav.scrolled{background:rgba(5,4,9,.72);backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}
  .nav{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;height:58px}
  .logo{display:flex;align-items:center;gap:8px;font-weight:700;font-size:15.5px;justify-self:start;letter-spacing:.02em;text-transform:uppercase}
  .navlinks{display:flex;gap:26px;font-size:13.5px;font-weight:500;color:var(--mut);justify-self:center}
  .navlinks a:hover{color:var(--ink)}
  .navcta{display:flex;gap:16px;align-items:center;justify-self:end}
  .navcta a.login{font-size:13.5px;font-weight:500;color:var(--mut);cursor:pointer}
  .navcta a.login:hover{color:var(--ink)}
  .navcta .btn.primary{padding:7px 16px;font-size:13px;border-radius:999px}
  .lang:hover{color:var(--ink)}
  .burger{display:none;font-size:22px;background:none;border:1px solid var(--line2);border-radius:9px;width:38px;height:38px;color:var(--ink)}

  /* ===== HERO — custom aurora background asset, centered, 100vh ===== */
  .hero{position:relative;text-align:center;overflow:hidden;isolation:isolate;
    min-height:100vh;min-height:100svh;display:flex;flex-direction:column;align-items:center;justify-content:center;
    gap:64px;padding:120px 0 56px;
    background-image:url('/assets/background.png');background-size:cover;background-position:center;background-repeat:no-repeat}
  .hero::before{content:"";position:absolute;inset:0;z-index:-1;
    background:linear-gradient(180deg,rgba(5,4,9,.35) 0%,rgba(5,4,9,.05) 32%,rgba(5,4,9,.35) 68%,var(--bg) 100%)}
  .hcontent{max-width:860px;margin:0 auto}
  .hero h1{font-size:78px;line-height:1.0;font-weight:500;letter-spacing:-.045em;margin-top:26px;color:#fff}
  .hero p.lead{font-size:20px;color:var(--mut);max-width:560px;margin:26px auto 34px;font-weight:450}
  .heroctas{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}
  .subtrust{margin-top:26px;font-family:var(--mono);font-size:12.5px;color:var(--dim)}

  /* tools-fly — icons orbiting a sticky, scroll-swapped headline (flowbase arcana-integration-03 style) */
  .tools-fly{position:relative;height:500vh}
  .tf-sticky{position:sticky;top:0;height:100vh;overflow:hidden;display:flex;align-items:center;justify-content:center}
  .tf-field{position:absolute;inset:0;max-width:1080px;margin:0 auto;--dur:24s;--r:340px}
  .tf-center{position:absolute;inset:0;z-index:2;display:flex;align-items:center;justify-content:center;text-align:center}
  .tf-eyebrow{position:absolute;top:50%;left:50%;transform:translate(-50%,-92px);z-index:3}
  .tf-msg{position:absolute;font-size:40px;font-weight:500;letter-spacing:-.025em;line-height:1.2;color:#fff;max-width:560px;
    opacity:0;transform:translateY(10px);transition:opacity .5s ease,transform .5s ease;pointer-events:none}
  .tf-msg.active{opacity:1;transform:translateY(0)}
  .tf-orbit{position:absolute;top:50%;left:50%;width:0;height:0;animation:tfSpin var(--dur) linear infinite;animation-delay:var(--delay,0s)}
  .tf-icon{position:absolute;top:calc(-1 * var(--r));left:-28px;width:56px;height:56px;border-radius:50%;
    background:#0b0a13;border:1px solid rgba(255,255,255,.12);display:grid;place-items:center;color:#fff;
    font-family:var(--mono);font-weight:700;font-size:22px;line-height:1;
    box-shadow:0 14px 30px -14px rgba(0,0,0,.6);animation:tfSpinRev var(--dur) linear infinite;animation-delay:var(--delay,0s)}
  .tf-icon img{width:100%;height:100%;object-fit:cover;border-radius:50%}
  @keyframes tfSpin{from{transform:rotate(0)}to{transform:rotate(360deg)}}
  @keyframes tfSpinRev{from{transform:rotate(0)}to{transform:rotate(-360deg)}}

  /* ===== CAROUSEL — sits inside hero, below CTA. Hover-focus style ===== */
  .carwrap{width:100%}
  .carousel{overflow:hidden;padding:10px 0 6px;
    -webkit-mask-image:linear-gradient(90deg,transparent,#000 4%,#000 96%,transparent);
    mask-image:linear-gradient(90deg,transparent,#000 4%,#000 96%,transparent)}
  .track{display:flex;gap:22px;width:max-content;animation:scroll 44s linear infinite;padding:14px 0}
  .carousel:hover .track{animation-play-state:paused}
  @keyframes scroll{from{transform:translateX(0)}to{transform:translateX(calc(-50% - 11px))}}
  .citem{flex:0 0 auto;width:430px;transition:transform .35s cubic-bezier(.22,.9,.32,1),opacity .35s,filter .35s;cursor:pointer}
  .citem:hover{transform:scale(1.08) translateY(-10px);z-index:5}
  .track:has(.citem:hover) .citem:not(:hover){transform:scale(.9);opacity:.5;filter:blur(1px)}
  .cc{border-radius:12px;overflow:hidden;background:var(--panel);box-shadow:0 20px 50px -24px rgba(0,0,0,.6)}
  .cc .pv{height:220px;display:grid;place-items:center;color:#fff;font-weight:600;font-size:15px;position:relative;background-size:cover;background-position:center}
  .cc .pv::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent,rgba(0,0,0,.32))}
  .ccap{display:flex;justify-content:space-between;align-items:center;padding:11px 3px 0}
  .ccap .name{display:flex;align-items:center;gap:8px;color:#fff;font-weight:600;font-size:13.5px}
  .ccap .name .ic{width:20px;height:20px;border-radius:6px;display:grid;place-items:center;font-size:11px}
  .ccap .count{display:flex;align-items:center;gap:5px;font-family:var(--mono);font-size:11.5px;color:var(--dim)}

  /* ===== FEATURES — bento grid, animated demos ===== */
  .fgrid{display:flex;flex-direction:column;gap:20px}
  .frow{display:grid;gap:20px}
  .frow-1{grid-template-columns:1fr}
  .frow-2{grid-template-columns:1fr 1fr}
  .fcard{border:1px solid var(--line);border-radius:20px;background:var(--panel);overflow:hidden;position:relative}
  .fcard-text{padding:46px;display:flex;flex-direction:column;justify-content:center}
  .fcard-text h3{font-size:21px;font-weight:600;margin-bottom:12px;color:#fff;letter-spacing:-.02em;line-height:1.3}
  .fcard-text p{color:var(--mut);font-size:14.5px;line-height:1.65}

  .fcard-hero{display:flex;align-items:stretch;min-height:380px}
  .fh-text{flex:0 0 38%;padding:46px;display:flex;flex-direction:column;justify-content:center}
  .fh-text h3{font-size:21px;font-weight:600;margin-bottom:12px;color:#fff;letter-spacing:-.02em;line-height:1.3}
  .fh-text p{color:var(--mut);font-size:14.5px;line-height:1.65}
  .fh-demo{flex:1;position:relative;display:flex;align-items:center;justify-content:center;padding:26px;
    overflow:hidden;
    background-color:var(--panel);background-image:radial-gradient(circle,rgba(255,255,255,.05) 1px,transparent 1px);background-size:20px 20px;
    -webkit-mask-image:linear-gradient(90deg,transparent,#000 10%,#000 90%,transparent);
    mask-image:linear-gradient(90deg,transparent,#000 10%,#000 90%,transparent)}
  .fh-flow{position:relative;width:100%;height:100%;min-height:300px;perspective:1400px}
  .fh-slide{position:absolute;top:50%;left:50%;width:340px;height:210px;border-radius:12px;
    background-size:cover;background-position:center;box-shadow:0 24px 50px -10px rgba(0,0,0,.55);border:1px solid rgba(255,255,255,.08);
    transition:transform .9s cubic-bezier(.45,0,.2,1),opacity .9s ease}
  .fh-badge{position:absolute;left:14px;bottom:14px;z-index:6;font-family:var(--mono);font-size:11.5px;color:#fff;
    background:rgba(9,8,14,.6);backdrop-filter:blur(6px);border:1px solid rgba(255,255,255,.14);border-radius:999px;padding:6px 13px;
    display:inline-flex;align-items:center;gap:7px}
  .fh-badge::before{content:"";width:6px;height:6px;border-radius:50%;background:var(--v);box-shadow:0 0 6px rgba(168,85,247,.7)}

  .fcard-photo{background-image:linear-gradient(180deg,rgba(9,8,15,.5),rgba(9,8,15,.88)),url('/assets/background.png');
    background-size:cover;background-position:center;padding:38px;display:flex;flex-direction:column;justify-content:space-between;gap:26px;min-height:300px}
  .fcard-photo h3{color:#fff;font-size:21px;font-weight:600;margin-bottom:12px;letter-spacing:-.02em;line-height:1.3}
  .fcard-photo p{color:rgba(244,244,250,.72);font-size:14.5px;line-height:1.65}
  .asset-card{align-self:stretch;background:rgba(16,15,25,.85);backdrop-filter:blur(8px);border:1px solid rgba(255,255,255,.1);
    border-radius:14px;padding:14px 16px;width:100%;box-shadow:0 30px 60px -20px rgba(0,0,0,.6)}
  .ac-row{display:flex;justify-content:space-between;align-items:center;padding:9px 0;font-size:12.5px;color:#fff;border-bottom:1px solid rgba(255,255,255,.07)}
  .ac-row-label{display:inline-flex;align-items:center;gap:7px}
  .ac-row:last-child{border-bottom:0}
  .ac-row.ac-main span{font-weight:600}
  .ac-copy,.ac-dl{font-family:var(--sans);font-weight:600;font-size:10.5px;border:1px solid rgba(255,255,255,.18);background:rgba(255,255,255,.06);color:#fff;border-radius:999px;padding:5px 11px;position:relative}
  .ac-dl{padding-left:20px}
  .ac-dl::before{content:"";position:absolute;left:9px;top:50%;transform:translateY(-50%);width:6px;height:6px;border-radius:50%;background:var(--v);animation:pulse 1.8s ease-in-out infinite}
  @keyframes pulse{0%,100%{opacity:.4;transform:translateY(-50%) scale(.8)}50%{opacity:1;transform:translateY(-50%) scale(1.15)}}

  .fcard-search{padding:38px;display:flex;flex-direction:column;gap:22px}
  .fcard-search h3{font-size:21px;font-weight:600;color:#fff;margin-bottom:12px;letter-spacing:-.02em;line-height:1.3}
  .fcard-search p{color:var(--mut);font-size:14.5px;line-height:1.65}
  .fcard-visual{margin-top:auto}
  .searchbar{display:flex;align-items:center;gap:10px;background:var(--panel2);border:1px solid var(--line2);border-radius:12px;padding:12px 16px;font-family:var(--mono);font-size:13px;color:var(--mut)}
  .sb-ic{opacity:.6}
  .sb-type{color:#fff}
  .sb-cursor{animation:blink 1s step-start infinite}
  @keyframes blink{50%{opacity:0}}
  .resrows{margin-top:14px;display:flex;flex-direction:column;gap:8px}
  .rrow{display:flex;align-items:center;gap:10px;background:rgba(255,255,255,.03);border:1px solid var(--line);border-radius:10px;padding:8px 12px;opacity:0;animation:rowIn .5s ease forwards}
  .rrow:nth-child(1){animation-delay:.1s}.rrow:nth-child(2){animation-delay:.25s}.rrow:nth-child(3){animation-delay:.4s}
  @keyframes rowIn{from{opacity:0;transform:translateX(-8px)}to{opacity:1;transform:translateX(0)}}
  .rr-ic{width:24px;height:24px;border-radius:7px;display:grid;place-items:center;flex:0 0 auto}
  .rr-ic .lucide{width:13px;height:13px}
  .rr-name{flex:1;font-size:13px;color:#fff;font-weight:500}
  .rr-tag{font-family:var(--mono);font-size:10px;color:var(--dim);background:rgba(255,255,255,.05);border:1px solid var(--line);padding:2px 8px;border-radius:999px}

  /* ===== HOW IT WORKS — auto-advancing tabs ===== */
  .howgrid{display:grid;grid-template-columns:.85fr 1.15fr;gap:64px;align-items:center}
  .how-left h2{font-size:38px;font-weight:600;letter-spacing:-.03em;margin:14px 0 12px;color:#fff;line-height:1.15;text-align:left}
  .how-left p.hlead{color:var(--mut);font-size:16px;line-height:1.6;max-width:420px}
  .how-steps{margin-top:38px;display:flex;flex-direction:column}
  .how-step{display:flex;gap:18px;padding:20px 0;cursor:pointer;opacity:.5;transition:opacity .3s}
  .how-step.active{opacity:1}
  .how-bar{width:3px;border-radius:3px;background:var(--line2);flex:0 0 auto;align-self:stretch;position:relative;overflow:hidden}
  .how-fill{position:absolute;left:0;top:0;width:100%;height:100%;background:linear-gradient(180deg,var(--v),var(--p));border-radius:3px;transform-origin:top;transform:scaleY(0)}
  .how-step-text h4{font-size:17px;font-weight:600;color:#fff;margin-bottom:0;letter-spacing:-.01em;transition:margin-bottom .3s}
  .how-step.active .how-step-text h4{margin-bottom:6px}
  .how-step-text p{font-size:13.5px;color:var(--mut);line-height:1.55;max-width:340px;
    max-height:0;opacity:0;overflow:hidden;transition:max-height .35s ease,opacity .3s ease}
  .how-step.active .how-step-text p{max-height:120px;opacity:1}
  .how-right{position:relative;min-height:420px}
  .how-right::before{content:"";position:absolute;inset:-60px;z-index:0;border-radius:32px;
    background-image:url('/assets/how-it-works.png');background-size:cover;background-position:center}
  .how-panel{position:absolute;z-index:1;inset:0;border:1px solid var(--line);border-radius:18px;background:#0c0b13;overflow:hidden;
    opacity:0;transform:translateY(10px);transition:opacity .4s,transform .4s;pointer-events:none;display:flex;flex-direction:column}
  .how-panel.active{opacity:1;transform:translateY(0);pointer-events:auto}
  .hp-body{padding:26px}

  /* step 1 — scrolling component library */
  .hp-lib{flex:1;padding:0;position:relative;overflow:hidden;
    -webkit-mask-image:linear-gradient(180deg,transparent,#000 14%,#000 86%,transparent);
    mask-image:linear-gradient(180deg,transparent,#000 14%,#000 86%,transparent)}
  .hp-lib-track{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;padding:24px;animation:hpLibScroll 18s linear infinite}
  .hp-lib:hover .hp-lib-track{animation-play-state:paused}
  .hp-lib-card{position:relative;aspect-ratio:16/10;border-radius:9px;overflow:hidden;background-size:cover;background-position:center;border:1px solid var(--line2)}
  @keyframes hpLibScroll{to{transform:translateY(-50%)}}
  .hp-lib-ov{position:absolute;inset:0;z-index:2;background:rgba(9,8,14,.55);backdrop-filter:blur(4px);-webkit-backdrop-filter:blur(4px);
    display:flex;align-items:center;justify-content:center;gap:6px;opacity:0;transition:opacity .2s}
  .hp-lib-card:hover .hp-lib-ov,.hp-lib-card.touch .hp-lib-ov{opacity:1}
  .hp-lib-btn{font-family:var(--sans);font-weight:600;font-size:10px;padding:5px 10px;border-radius:999px;border:none;background:#fff;color:#0d0c14;cursor:default}
  .hp-lib-btn.ghost{background:rgba(255,255,255,.14);color:#fff;border:1px solid rgba(255,255,255,.28)}
  .hp-lib-cursor{position:absolute;z-index:5;width:20px;height:20px;top:0;left:0;pointer-events:none;
    filter:drop-shadow(0 3px 6px rgba(0,0,0,.6));transition:top .8s cubic-bezier(.22,.68,0,1),left .8s cubic-bezier(.22,.68,0,1);opacity:0}
  .hp-lib-cursor.show{opacity:1}

  /* shared "code card" chrome, reused by steps 2 & 3 */
  .dc-bar{display:flex;gap:5px;align-items:center;padding:9px 11px;border-bottom:1px solid var(--line)}
  .dc-bar i{width:7px;height:7px;border-radius:50%;background:#2a2839;display:inline-block}
  .dc-u{margin-left:6px;font-family:var(--mono);font-size:9.5px;color:var(--dim)}
  .dc-body{padding:13px}
  .dc-btn{margin-top:10px;font-family:var(--sans);font-weight:600;font-size:11.5px;border:none;border-radius:999px;padding:9px 16px;background:#fff;color:#0d0c14;cursor:default;transition:background .2s,color .2s}
  .dc-btn.copied{background:var(--v);color:#fff}
  .dc-skel{height:9px;border-radius:5px;background:linear-gradient(90deg,var(--line2) 25%,rgba(255,255,255,.14) 50%,var(--line2) 75%);background-size:220% 100%;animation:shimmer 2.6s linear infinite}
  .dc-skel.s1{width:100%} .dc-skel.s2{width:82%} .dc-skel.s3{width:60%}
  @keyframes shimmer{0%{background-position:220% 0}100%{background-position:-220% 0}}

  /* step 2 — zoom on copy */
  .hp-copy{flex:1;position:relative;display:flex;align-items:center;justify-content:center;padding:26px;overflow:hidden}
  .hp-copy-bg{position:absolute;inset:0;background-size:cover;background-position:center;filter:blur(5px) brightness(.42);transform:scale(1.08)}
  .hp-copy-card{position:relative;z-index:1;width:100%;max-width:420px;border:1px solid var(--line2);border-radius:14px;overflow:hidden;background:var(--panel);
    box-shadow:0 30px 60px -20px rgba(0,0,0,.65);
    transition:transform .6s cubic-bezier(.22,.68,0,1),box-shadow .6s}
  .hp-copy-card.zoom{transform:scale(1.035);box-shadow:0 30px 60px -16px rgba(168,85,247,.4)}
  .hpc-head{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px 16px;border-bottom:1px solid var(--line)}
  .hpc-title b{display:block;font-size:12.5px;font-weight:700;color:#fff;letter-spacing:-.01em}
  .hpc-title span{display:block;margin-top:3px;font-family:var(--mono);font-size:9.5px;color:var(--dim);text-transform:uppercase;letter-spacing:.03em}
  .hpc-actions{display:flex;align-items:center;gap:7px;flex:0 0 auto}
  .hpc-view{font-family:var(--sans);font-weight:600;font-size:10px;padding:7px 11px;border-radius:999px;border:1px solid var(--line2);background:transparent;color:#fff;cursor:default;white-space:nowrap;line-height:1}
  .hpc-tabs{display:flex;gap:16px;padding:0 16px;border-bottom:1px solid var(--line)}
  .hpc-tab{padding:9px 0;font-size:10.5px;font-weight:600;color:var(--dim);border-bottom:2px solid transparent}
  .hpc-tab.active{color:#fff;border-color:var(--v)}
  .hpc-body{padding:14px 16px}
  .hp-copy-code{display:block;font-family:var(--mono);font-size:10.5px;color:var(--mut);line-height:1.65;min-height:74px}
  .hp-copy-card .dc-btn{padding:7px 14px;white-space:nowrap;line-height:1}
  .hp-copy-cursor{position:absolute;z-index:5;width:20px;height:20px;top:0;left:0;pointer-events:none;
    filter:drop-shadow(0 3px 6px rgba(0,0,0,.6));opacity:0;
    transition:top .7s cubic-bezier(.22,.68,0,1),left .7s cubic-bezier(.22,.68,0,1),transform .15s ease}
  .hp-copy-cursor.show{opacity:1}
  .hp-copy-cursor.click{transform:scale(.8)}

  /* step 3 — code editor: paste + generate */
  .hp-gen{flex:1;position:relative;display:flex;flex-direction:column;gap:14px;padding:26px;overflow:hidden}
  .hp-editor{border:1px solid var(--line2);border-radius:14px;overflow:hidden;background:var(--panel);flex:0 0 auto}
