---
import '../styles/tokens.css';
import AuthModal from '../components/AuthModal.astro';

interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title} · esprompt</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
</head>
<body>

<div class="topbar-gradient"></div>
<nav>
  <div class="wrap nav">
    <a class="logo" href="/">esprompt</a>
    <div class="navlinks" id="navTierLinks">
      <a href="/library?tier=Full%20LP" data-tier="Full LP">Landing</a>
      <a href="/library?tier=Hero" data-tier="Hero">Hero</a>
      <a href="/library?tier=Section" data-tier="Section">Section</a>
    </div>
    <div class="navcta" id="navCta">
      <form class="nav-searchbox" id="navSearchForm" role="search">
        <svg class="lucide" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        <input type="text" id="navSearchInput" placeholder="Search" autocomplete="off">
        <kbd>/</kbd>
      </form>
      <a class="login" onclick="openAuthModal('login')">Log In</a>
      <a class="btn primary" onclick="openAuthModal('signup')">Sign Up</a>
    </div>
    <button class="burger" aria-label="Menu">≡</button>
  </div>
</nav>

<main class="app-main wrap">
  <slot />
</main>

<footer>
  <div class="wrap">
    <div class="foot-top">
      <div class="foot-brand">
        <div class="logo">esprompt</div>
      </div>
      <div class="foot-col">
        <h5>Product</h5>
        <a href="/library">Library</a>
        <a href="/#harga">Pricing</a>
      </div>
      <div class="foot-col">
        <h5>Learn</h5>
        <a href="/#how">How it works</a>
        <a href="/#faq">FAQ</a>
      </div>
    </div>
    <div class="foot-bottom">
      <span class="copy">© 2026 esprompt · by Elux Space</span>
      <div class="foot-social">
        <a href="#" aria-label="Instagram"><svg class="lucide" viewBox="0 0 24 24"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg></a>
        <a href="#" aria-label="X (Twitter)"><svg class="lucide" viewBox="0 0 24 24"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg></a>
        <a href="#" aria-label="LinkedIn"><svg class="lucide" viewBox="0 0 24 24"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg></a>
      </div>
    </div>
  </div>
</footer>

<AuthModal />

<script is:inline>
  /* The prompt text is stored once, in the .pd-code block of each item's detail
     markup. Reading it back from there keeps a 1,700-word prompt out of a
     duplicate data-prompt attribute — that duplication was most of the page weight. */
  function espPromptText(btn){
    const open=btn.closest('.prompt-detail')?.querySelector('.pd-code');
    if(open) return open.textContent||'';
    const tpl=document.getElementById('tpl-'+(btn.dataset.slug||''));
    return tpl?.content.querySelector('.pd-code')?.textContent||'';
  }
  const navEl = document.querySelector('nav');
  function onScroll(){ navEl.classList.toggle('scrolled', window.scrollY > 24); }
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Highlight Hero/Landing/Section based on the current ?tier=. Can't be
  // done server-side since this is a static build (no query string at
  // render time), so it's a client-side match against the live URL.
  // Trailing-slash tolerant: the static host redirects /library to /library/
  // (dev server doesn't), so a strict === '/library' match silently failed
  // in production only.
  if (location.pathname.replace(/\/+$/, '') === '/library') {
    const currentTier = new URLSearchParams(location.search).get('tier');
    document.querySelectorAll('#navTierLinks a').forEach(a => {
      a.classList.toggle('active', a.dataset.tier === currentTier);
    });
  }

  // scroll reveal for any element marked .reveal
  const revealEls = [...document.querySelectorAll('.reveal')];
  const revealIO = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) { entry.target.classList.add('in'); revealIO.unobserve(entry.target); }
    });
  }, { threshold: .12, rootMargin: '0px 0px -40px 0px' });
  revealEls.forEach(el => revealIO.observe(el));

  const SEARCH_BOX = `<form class="nav-searchbox" id="navSearchForm" role="search">
    <svg class="lucide" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
    <input type="text" id="navSearchInput" placeholder="Search" autocomplete="off">
    <kbd>/</kbd>
  </form>`;

  // Nav search: submits to /library?q=… (library.astro reads it on load, same
  // pattern as ?tier=). Always a fresh navigation, simplest thing that works
  // across pages, no cross-page JS state to keep in sync.
  function bindNavSearch(){
    const form = document.getElementById('navSearchForm');
    if (!form) return;
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const q = document.getElementById('navSearchInput').value.trim();
      window.location.href = q ? `/library?q=${encodeURIComponent(q)}` : '/library';
    });
  }
  document.addEventListener('keydown', (e) => {
    if (e.key !== '/') return;
    const tag = document.activeElement?.tagName;
    if (tag === 'INPUT' || tag === 'TEXTAREA') return;
    const input = document.getElementById('navSearchInput');
    if (input) { e.preventDefault(); input.focus(); }
  });

  // fake-session nav state: swap Log in/Sign up for an avatar+dropdown once
  // "logged in". Library lives inside the dropdown, not as a top-level link.
  function renderNavSession(){
    const cta = document.getElementById('navCta');
    if (!cta) return;
    if (window.espHasSession && window.espHasSession()) {
      const user = window.espGetUser ? window.espGetUser() : { name: 'You' };
      const initial = (user.name || 'U').trim().charAt(0).toUpperCase() || 'U';
      cta.innerHTML = `${SEARCH_BOX}
        <a class="btn ghost nav-upgrade" href="/billing">Become Pro</a>
        <div class="nav-account" id="navAccount">
          <button class="nav-avatar" id="navAvatarBtn" aria-haspopup="true" aria-expanded="false" aria-label="Account menu">${initial}</button>
          <div class="nav-dropdown" id="navDropdown" hidden>
            <a href="/account">Account</a>
            <a href="/billing">Upgrade</a>
            <button type="button" id="navLogoutBtn">Log Out</button>
          </div>
        </div>`;
      const avatarBtn = document.getElementById('navAvatarBtn');
      const dropdown = document.getElementById('navDropdown');
      avatarBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const open = dropdown.hidden;
        dropdown.hidden = !open;
        avatarBtn.setAttribute('aria-expanded', String(open));
      });
      document.getElementById('navLogoutBtn').addEventListener('click', () => {
        localStorage.removeItem('esprompt_session');
        window.dispatchEvent(new CustomEvent('esprompt:session-change'));
        window.location.href = '/';
      });
    } else {
      cta.innerHTML = `${SEARCH_BOX}<a class="login" onclick="openAuthModal('login')">Log In</a><a class="btn primary" onclick="openAuthModal('signup')">Sign Up</a>`;
    }
    bindNavSearch();
  }
  document.addEventListener('click', () => {
    const dropdown = document.getElementById('navDropdown');
    const avatarBtn = document.getElementById('navAvatarBtn');
    if (dropdown && !dropdown.hidden) { dropdown.hidden = true; avatarBtn?.setAttribute('aria-expanded', 'false'); }
  });
  window.addEventListener('esprompt:session-change', renderNavSession);
  renderNavSession();

  // Prompt detail interactions: delegated on document.body so this works
  // for PromptDetailContent cloned into the /library quick-preview modal
  // (a <script> inside the source <template> never runs, even after cloning,
  // see library.astro).
  const ESP_ICON_SPIN = '<svg class="lucide spin" viewBox="0 0 24 24"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>';
  const ESP_ICON_CHECK = '<svg class="lucide" viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg>';
  // Swaps a button's whole contents to a spinner+label, then a check+label,
  // then restores the original markup, so copy/download buttons show real
  // "in progress" feedback instead of an instant label flip.
  function flashAction(btn, loadingLabel, doneLabel){
    if (btn.dataset.busy) return;
    btn.dataset.busy = '1';
    const original = btn.innerHTML;
    btn.innerHTML = `${ESP_ICON_SPIN}<span>${loadingLabel}</span>`;
    setTimeout(() => {
      btn.innerHTML = `${ESP_ICON_CHECK}<span>${doneLabel}</span>`;
      setTimeout(() => {
        btn.innerHTML = original;
        delete btn.dataset.busy;
      }, 1200);
    }, 450);
  }
  // Triggers a real browser download for a static asset URL via a throwaway
  // anchor — same-origin files under /public download instead of navigating.
  function triggerDownload(url, filename){
    const a = document.createElement('a');
    a.href = url;
    if (filename) a.download = filename;
    document.body.appendChild(a);
    a.click();
    a.remove();
  }

  function triggerBlobDownload(blob, filename){
    const url = URL.createObjectURL(blob);
    triggerDownload(url, filename);
    setTimeout(() => URL.revokeObjectURL(url), 1000);
  }

  // Build a dependency-free ZIP in the browser. Store-only entries keep the
  // implementation small and preserve already-compressed PNG/MP4/WebM files.
  function zipCrc32(bytes){
    let crc = 0xffffffff;
    for (const byte of bytes) {
      crc ^= byte;
      for (let bit = 0; bit < 8; bit++) crc = (crc >>> 1) ^ (0xedb88320 & -(crc & 1));
    }
    return (crc ^ 0xffffffff) >>> 0;
  }
  function zipU16(view, offset, value){ view.setUint16(offset, value, true); }
  function zipU32(view, offset, value){ view.setUint32(offset, value >>> 0, true); }
  async function createAssetZip(assets){
    const encoder = new TextEncoder();
    const files = await Promise.all(assets.map(async (asset) => {
      const response = await fetch(asset.url);
      if (!response.ok) throw new Error(`Could not fetch ${asset.url}`);
      return { path: `${asset.type}/${asset.filename.replace(/[\\/]+/g, '-')}`, bytes: new Uint8Array(await response.arrayBuffer()) };
    }));
    const localParts = [], centralParts = [];
    let offset = 0;
    files.forEach((file) => {
      const name = encoder.encode(file.path);
      const crc = zipCrc32(file.bytes);
      const local = new Uint8Array(30 + name.length + file.bytes.length);
      const localView = new DataView(local.buffer);
      zipU32(localView, 0, 0x04034b50); zipU16(localView, 4, 20); zipU16(localView, 6, 0);
      zipU16(localView, 8, 0); zipU16(localView, 10, 0); zipU16(localView, 12, 0);
      zipU32(localView, 14, crc); zipU32(localView, 18, file.bytes.length); zipU32(localView, 22, file.bytes.length);
      zipU16(localView, 26, name.length); zipU16(localView, 28, 0);
      local.set(name, 30); local.set(file.bytes, 30 + name.length);
      localParts.push(local);

      const central = new Uint8Array(46 + name.length);
      const centralView = new DataView(central.buffer);
      zipU32(centralView, 0, 0x02014b50); zipU16(centralView, 4, 20); zipU16(centralView, 6, 20);
      zipU16(centralView, 8, 0); zipU16(centralView, 10, 0); zipU16(centralView, 12, 0); zipU16(centralView, 14, 0);
      zipU32(centralView, 16, crc); zipU32(centralView, 20, file.bytes.length); zipU32(centralView, 24, file.bytes.length);
      zipU16(centralView, 28, name.length); zipU16(centralView, 30, 0); zipU16(centralView, 32, 0);
      zipU16(centralView, 34, 0); zipU16(centralView, 36, 0); zipU32(centralView, 38, 0); zipU32(centralView, 42, offset);
      central.set(name, 46); centralParts.push(central);
      offset += local.length;
    });

    const centralSize = centralParts.reduce((sum, part) => sum + part.length, 0);
    const end = new Uint8Array(22);
    const endView = new DataView(end.buffer);
    zipU32(endView, 0, 0x06054b50); zipU16(endView, 4, 0); zipU16(endView, 6, 0);
    zipU16(endView, 8, files.length); zipU16(endView, 10, files.length);
    zipU32(endView, 12, centralSize); zipU32(endView, 16, offset); zipU16(endView, 20, 0);
    return new Blob([...localParts, ...centralParts, end], { type: 'application/zip' });
  }

  document.body.addEventListener('click', (e) => {
    const tab = e.target.closest('.hpc-tab');
    if (tab) {
      const tabs = tab.closest('[data-tabs]');
      // Look up to the whole detail block (not just the tab strip's direct
      // parent) since the tabs live in a separate toolbar from the panels.
      const container = tabs.closest('.prompt-detail') || tabs.parentElement;
      tabs.querySelectorAll('.hpc-tab').forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      container.querySelectorAll('.pd-tabpanel').forEach(p => { p.hidden = p.dataset.tabpanel !== tab.dataset.tab; });
      // The Assets tab swaps "Copy Prompt" for "Download All Assets" in the
      // card-bar, since copying a single prompt doesn't apply there.
      const onAssets = tab.dataset.tab === 'assets';
      container.querySelectorAll('.pd-copy-btn:not(.detail-dlall-btn)').forEach(b => { b.hidden = onAssets; });
      container.querySelectorAll('.detail-dlall-btn').forEach(b => { b.hidden = !onAssets; });
      return;
    }

    // Topbar close (modal variant only, see library.astro's openDetailModal).
    const closeBtn = e.target.closest('[data-close-modal]');
    if (closeBtn) {
      window.closeDetailModal?.();
      return;
    }

    // Topbar share: copies the library page URL, not the prompt text.
    const shareBtn = e.target.closest('.detail-share-btn');
    if (shareBtn) {
      navigator.clipboard?.writeText(`${location.origin}/library`);
      shareBtn.classList.add('copied');
      setTimeout(() => shareBtn.classList.remove('copied'), 1500);
      return;
    }

    const copyBtn = e.target.closest('.detail-copy-btn');
    if (copyBtn) {
      const doCopy = () => {
        navigator.clipboard?.writeText(espPromptText(copyBtn));
        flashAction(copyBtn, 'Copying…', 'Copied');
      };
      if (window.espHasSession && window.espHasSession()) doCopy();
      else window.openAuthModal('signup', doCopy);
      return;
    }

    const dlAllBtn = e.target.closest('.detail-dlall-btn');
    if (dlAllBtn) {
      const doDownloadAll = async () => {
        if (dlAllBtn.dataset.busy) return;
        dlAllBtn.dataset.busy = '1';
        const original = dlAllBtn.innerHTML;
        dlAllBtn.innerHTML = `${ESP_ICON_SPIN}<span>Preparing ZIP…</span>`;
        try {
          const assets = JSON.parse(dlAllBtn.dataset.assets || '[]');
          const zip = await createAssetZip(assets);
          triggerBlobDownload(zip, `${dlAllBtn.dataset.slug || 'hero'}-assets.zip`);
          dlAllBtn.innerHTML = `${ESP_ICON_CHECK}<span>Downloaded ZIP</span>`;
        } catch (error) {
          console.error('Asset ZIP download failed', error);
          dlAllBtn.innerHTML = '<span>Download failed</span>';
        }
        setTimeout(() => { dlAllBtn.innerHTML = original; delete dlAllBtn.dataset.busy; }, 1500);
      };
      doDownloadAll();
      return;
    }

    const dlBtn = e.target.closest('.detail-dl-btn');
    if (dlBtn) {
      const doDownload = () => {
        flashAction(dlBtn, 'Downloading…', 'Downloaded');
        if (dlBtn.dataset.url) triggerDownload(dlBtn.dataset.url, dlBtn.dataset.filename);
      };
      doDownload();
    }

    // Copy prompt button inside the Assets tab (Layout C).
    const assetCopyBtn = e.target.closest('.pd-assets-split .ac-copy');
    if (assetCopyBtn && assetCopyBtn.dataset.prompt) {
      e.stopPropagation();
      navigator.clipboard?.writeText(assetCopyBtn.dataset.prompt);
      flashAction(assetCopyBtn, 'Copying…', 'Copied');
      return;
    }

    // Layout C asset thumbnail strip — switch the selected preview, prompt,
    // title, and download target. Works in the modal because the listener is
    // delegated on the document.
    const layoutCThumb = e.target.closest('.pd-assets-thumb[data-role="thumb"]');
    if (layoutCThumb) {
      const root = layoutCThumb.closest('.pd-assets-split');
      if (!root) return;
      let assets = [];
      try { assets = JSON.parse(root.dataset.assets || '[]'); } catch { return; }
      const idx = Number(layoutCThumb.dataset.index);
      const asset = assets[idx];
      if (!asset) return;

      root.querySelectorAll('[data-role="media"]').forEach(el => {
        const active = Number(el.dataset.index) === idx;
        el.hidden = !active;
        if (active && el.tagName === 'VIDEO') { el.currentTime = 0; el.play().catch(() => {}); }
        else if (!active && el.tagName === 'VIDEO') { el.pause(); }
      });
      root.querySelectorAll('[data-role="thumb"]').forEach(btn => {
        btn.classList.toggle('active', Number(btn.dataset.index) === idx);
      });
      const titleEl = root.querySelector('[data-role="title"]');
      const badgeEl = root.querySelector('[data-role="badge"]');
      const promptEl = root.querySelector('[data-role="prompt"]');
      const copyBtn = root.querySelector('[data-role="copy"]');
      const dlBtn = root.querySelector('[data-role="download"]');
      const capitalize = (s) => s ? s[0].toUpperCase() + s.slice(1) : s;
      if (titleEl) titleEl.textContent = asset.file || '';
      if (badgeEl) badgeEl.textContent = capitalize(asset.type);
      if (promptEl) {
        promptEl.textContent = asset.prompt || '';
        promptEl.hidden = !asset.prompt;
      }
      if (copyBtn) {
        copyBtn.dataset.prompt = asset.prompt || '';
        copyBtn.hidden = !asset.prompt;
        copyBtn.querySelector('span').textContent = 'Copy prompt';
      }
      if (dlBtn) { dlBtn.dataset.url = asset.url || ''; dlBtn.dataset.filename = asset.filename || asset.file || ''; }
      return;
    }
  });
</script>
</body>
</html>
